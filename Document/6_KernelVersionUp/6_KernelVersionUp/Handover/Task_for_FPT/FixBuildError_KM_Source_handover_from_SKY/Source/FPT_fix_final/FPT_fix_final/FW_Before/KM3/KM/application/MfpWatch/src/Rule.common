
####### Compiler, tools and options
CC            = $(MW_CROSSPREFIX)-linux-gcc
CXX           = $(MW_CROSSPREFIX)-linux-g++
#DEFINES       = -DLINUX -D$(MW_ATATYPE) -DQT_NO_DEBUG -DQT_GUI_LIB -DQT_NETWORK_LIB -DQT_CORE_LIB -DDEF_Stub_UIv5 -DQT_PANEL
DEFINES       = -DLINUX -DQT_NO_DEBUG 
CFLAGS        = -pipe -O2 -Werror=all -W -D_REENTRANT $(DEFINES) -fPIC
#2018/07/09 ADS平井 ビルド問題対応 start.
CFLAGS        += -Wno-unused-parameter
CFLAGS        += -Wno-unused-but-set-variable
CFLAGS        += -Wno-char-subscripts
CFLAGS        += -Wno-error=sign-compare
CFLAGS        += -Wno-error=conversion-null
CFLAGS        += -Wno-error=narrowing
CFLAGS        += -Wno-write-strings
CFLAGS        += -Wno-strict-aliasing
CFLAGS        += -Wconversion
CFLAGS        += -Werror=pointer-to-int-cast
CFLAGS        += -Werror=int-to-pointer-cast
CFLAGS        += -Werror=overflow
CFLAGS        += -Wformat-security
CFLAGS        += -fwrapv
CFLAGS        += -funwind-tables
CFLAGS        += -fno-builtin
CFLAGS        += -fno-inline
CFLAGS        += -fsigned-char
CFLAGS        += -fno-for-scope
CFLAGS        += -g
CFLAGS        += -ggdb
#2018/07/09 ADS平井 ビルド問題対応 end.
CXXFLAGS      = -pipe -O2 -Werror=all -W -D_REENTRANT $(DEFINES) -fPIC
#2018/07/09 ADS平井 ビルド問題対応 start.
CXXFLAGS      += -Wno-unused-parameter
CXXFLAGS      += -Wno-unused-but-set-variable
CXXFLAGS      += -Wno-char-subscripts
CXXFLAGS      += -Wno-error=sign-compare
CXXFLAGS      += -Wno-error=conversion-null
CXXFLAGS      += -Wno-error=narrowing
CXXFLAGS      += -Wno-write-strings
CXXFLAGS      += -Wno-strict-aliasing
CXXFLAGS      += -Wconversion
CXXFLAGS      += -Werror=pointer-to-int-cast
CXXFLAGS      += -Werror=int-to-pointer-cast
CXXFLAGS      += -Werror=overflow
CXXFLAGS      += -Wformat-security
CXXFLAGS      += -fwrapv
CXXFLAGS      += -funwind-tables
CXXFLAGS      += -fno-builtin
CXXFLAGS      += -fno-inline
CXXFLAGS      += -fsigned-char
CXXFLAGS      += -fno-for-scope
CXXFLAGS      += -g
CXXFLAGS      += -ggdb
#2018/07/09 ADS平井 ビルド問題対応 end.
ifeq ($(MW_CROSSPREFIX),mb86s72)
CFLAGS       += -funwind-tables -fno-aggressive-loop-optimizations
CXXFLAGS     += -funwind-tables -fno-aggressive-loop-optimizations
endif
#INCPATH       = -I$(MW_QTDIR)/mkspecs/linux-$(MW_MPCTYPE)-g++ -I. -I$(MW_QTDIR)/include/QtCore -I$(MW_QTDIR)/include/QtNetwork -I$(MW_QTDIR)/include/QtGui -I$(MW_QTDIR)/include/QtWidgets -I$(MW_QTDIR)/include
INCPATH       = -I.
LINK          = $(MW_CROSSPREFIX)-linux-g++
#LIBS          = $(SUBLIBS) -L$(MW_QTDIR)/lib -L$(MW_ICUDIR)/lib -lrt -L$(MW_KMFWLIB) -lQt5Gui -lQt5Core -lQt5Widgets -lpthread
LIBS          = $(SUBLIBS) -lrt -L$(MW_KMFWLIB) -lpthread
AR            = $(MW_CROSSPREFIX)-linux-ar cqs
RANLIB        = $(MW_CROSSPREFIX)-linux-ranlib
#QMAKE         = $(MW_QTDIR)/bin/qmake
TAR           = tar -cf
COMPRESS      = gzip -9f
COPY          = cp -f
SED           = sed
COPY_FILE     = $(COPY)
COPY_DIR      = $(COPY) -r
STRIP         = $(MW_CROSSPREFIX)-linux-strip
INSTALL_FILE  = install -m 644 -p
INSTALL_DIR   = $(COPY_DIR)
INSTALL_PROGRAM = install -m 755 -p
DEL_FILE      = rm -f
SYMLINK       = ln -f -s
DEL_DIR       = rmdir
MOVE          = mv -f
CHK_DIR_EXISTS= test -d
MKDIR         = mkdir -p

ifeq ($(MW_CROSSPREFIX),mb86s73)
CFLAGS        += -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mabi=aapcs-linux -mfloat-abi=hard -mlong-calls -mlittle-endian -fwrapv -marm
CXXFLAGS      += -pipe -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mabi=aapcs-linux -mfloat-abi=hard -mlong-calls -mlittle-endian -fwrapv -marm
endif

#PDD22G2ADD
ifeq ($(MW_CROSSPREFIX),i386)
CFLAGS        += -unwind-tables
CXXFLAGS      += -unwind-tables
endif

ifeq ($(MW_CROSSPREFIX),mv62x0)
CFLAGS        += -mcpu=cortex-a7 -mthumb-interwork -mfloat-abi=hard -mfpu=vfpv4-d16 -mthumb -mlong-calls -mlittle-endian -funwind-tables -mtls-dialect=gnu
CXXFLAGS      += -mcpu=cortex-a7 -mthumb-interwork -mfloat-abi=hard -mfpu=vfpv4-d16 -mthumb -mlong-calls -mlittle-endian -funwind-tables -mtls-dialect=gnu
endif

ifeq ($(MW_CROSSPREFIX),s800)
CFLAGS        += -Wconversion -mlittle-endian -unwind-tables -DDEF_64BIT_PF
CXXFLAGS      += -Wconversion -mlittle-endian -unwind-tables -DDEF_64BIT_PF
endif
ifeq ($(MW_CROSSPREFIX),x86_64)
CFLAGS        += -m64 -unwind-tables -DFUM_LINUX -DDEF_64BIT_PF
CXXFLAGS      += -m64 -unwind-tables -DFUM_LINUX -DDEF_64BIT_PF
endif

ifeq ($(ADDRESS_SANITIZER),YES)
CFLAGS        += -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
CXXFLAGS      += -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

####### Implicit rules
.SUFFIXES: .o .c .cpp .cc .cxx .C
.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"
.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"
.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"
.C.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o "$@" "$<"
.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o "$@" "$<"


####### Create moc
#moc_%.cpp : %.h
#	$(MW_QTDIR)/bin/moc $(DEFINES) $(INCPATH) $< -o $(OBJECTS_DIR)$@

####### Compile
#qrc_%.o: qrc_%.cpp
#	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $(OBJECTS_DIR)$@ $(OBJECTS_DIR)$<
#
#moc_%.o: moc_%.cpp
#	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $(OBJECTS_DIR)$@ $(OBJECTS_DIR)$<

%.o: %.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $(OBJECTS_DIR)$@ $<
