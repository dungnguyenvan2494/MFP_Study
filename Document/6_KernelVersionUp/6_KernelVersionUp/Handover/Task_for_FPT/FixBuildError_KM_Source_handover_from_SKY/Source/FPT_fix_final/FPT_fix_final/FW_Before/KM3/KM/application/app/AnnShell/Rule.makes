######################################################
#Default configuration of makefile
######################################################
MOC				= $(QTDIR)/bin/moc
GCC				= $(CROSS_COMPILE)gcc
CC				= $(CROSS_COMPILE)gcc
AS				= $(CROSS_COMPILE)as
LD				= $(CROSS_COMPILE)ld

######################################################
#ビルドオプション
######################################################
ifeq ($(ANNC_ANNSHL_DEBUG),1)
C++FLAGS	= -Werror=all -g -ggdb -O0 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DANNC_DEBUG_PRINT
else
ifeq ($(TLOGLIB_BUILD),NO)
ifeq ($(BASETYPE),all)
ifeq ($(CROSS_COMPILE),x86_64-linux-)
C++FLAGS	= -m64 -Werror=all -g -ggdb -O0 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG -DDEF_64BIT_PF 
else
C++FLAGS	= -Werror=all -g -ggdb -O0 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
endif
else
ifeq ($(CROSS_COMPILE),mv78460-linux-)
C++FLAGS	= -mcpu=marvell-pj4b -mfpu=vfpv3 -mabi=aapcs-linux -mlittle-endian -fwrapv -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
else
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
C++FLAGS	= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
else
ifeq ($(CROSS_COMPILE),mb86s72-linux-)
C++FLAGS	= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
else
ifeq ($(CROSS_COMPILE),mv62x0-linux-)
C++FLAGS	= -march=armv7-a -marm -mthumb-interwork -mfloat-abi=hard -mfpu=neon -mthumb -mlittle-endian -mtls-dialect=gnu -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
else
ifeq ($(CROSS_COMPILE),s800-linux-)
C++FLAGS	= -mlittle-endian -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG -DDEF_64BIT_PF 
else
C++FLAGS	= -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
endif
endif
endif
endif
endif
endif
else
ifeq ($(BASETYPE),all)
ifeq ($(CROSS_COMPILE),x86_64-linux-)
C++FLAGS	= -m64 -Werror=all -g -ggdb -O0 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG -DDEF_64BIT_PF
else
C++FLAGS	= -Werror=all -g -ggdb -O0 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
endif
else
ifeq ($(CROSS_COMPILE),mv78460-linux-)
C++FLAGS	= -mcpu=marvell-pj4b -mfpu=vfpv3 -mabi=aapcs-linux -mlittle-endian -fwrapv -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
else
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
C++FLAGS	= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
else
ifeq ($(CROSS_COMPILE),mb86s72-linux-)
C++FLAGS	= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -funwind-tables -fno-aggressive-loop-optimizations -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
else
ifeq ($(CROSS_COMPILE),mv62x0-linux-)
C++FLAGS	= -march=armv7-a -marm -mthumb-interwork -mfloat-abi=hard -mfpu=neon -mthumb -mlittle-endian -mtls-dialect=gnu -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
else
ifeq ($(CROSS_COMPILE),s800-linux-)
C++FLAGS	= -mlittle-endian -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG -DDEF_64BIT_PF
else
C++FLAGS	= -Werror=all -g -ggdb -O2 -fpic $(PRFAPI_INCS) -DLINUX -D_FILE_OFFSET_BITS=64 -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG 
endif
endif
endif
endif
endif
endif
endif
endif

# Timesys Toolchain コンパイルエラー対策
ifeq ($(IT4MACHINE_TYPE),kssfum)
C++FLAGS	+= -DDEF_A4_Cus -DDEF_KRONOSS_Cus
endif
ifeq ($(IT4MACHINE_TYPE),kss)
C++FLAGS	+= -DDEF_A4_Cus -DDEF_KRONOSS_Cus
endif

ifeq ($(ADDRESS_SANITIZER),YES)
C++FLAGS	+= -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

LDFLAGS     = $(PRFAPI_INCS)
