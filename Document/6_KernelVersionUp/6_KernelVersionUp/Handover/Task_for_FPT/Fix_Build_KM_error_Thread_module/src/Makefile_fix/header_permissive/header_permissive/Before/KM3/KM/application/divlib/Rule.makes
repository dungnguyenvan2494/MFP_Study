TSS_DEFINES	    += -DDEF_SCN1000 -DDEF_EDH_COLOR
endif

ifeq ($(BASETYPE),all)
#TSS_DEFINES += -DSIMULATOR -D_SIM -D_USE_IGC -DUFST_LINUX -DIMP_MFPSHELL
TSS_DEFINES += -D_USE_IGC -DUFST_LINUX -DIMP_MFPSHELL -DUSE_SIMHEADER
ifeq ($(ISQT),yes)
TSS_DEFINES += -DSIMQT2WAY
endif
endif

ifeq ($(BASETYPE),hw)
TSS_DEFINES += -DTORNADO -D_REAL -DIMP_MFPSHELL
ifeq ($(ISQT),yes)
TSS_DEFINES += -DDEF_PANELDRV
endif
endif

ifeq ($(ISQT),yes)
TSS_DEFINES += -DQT_PANEL
CC_INCLUDE  += -I$(QTDIR)/include
ifeq ($(QTVERSION),q530)
CC_INCLUDE  += -I$(QTDIR)/include/QtWidgets
else
CC_INCLUDE  += -I$(QTDIR)/include/Qt
endif
CC_INCLUDE  += -I$(QTDIR)/include/QtCore \
			   -I$(QTDIR)/include/QtGui
endif

CC_WARNING		= -Werror=all -Wno-unused-but-set-variable -Wno-char-subscripts -Wno-error=sign-compare -Wno-error=conversion-null -Wno-error=narrowing
CC_WARNING		+= -Wno-write-strings  -Wno-strict-aliasing -Wconversion -Werror=pointer-to-int-cast -Werror=int-to-pointer-cast -Werror=overflow
C++_WARNING		= -Werror=all -Wno-unused-but-set-variable -Wno-char-subscripts -Wno-error=sign-compare -Wno-error=conversion-null -Wno-error=narrowing
C++_WARNING		+= -Wno-write-strings  -Wno-strict-aliasing -Wconversion -Werror=pointer-to-int-cast -Werror=int-to-pointer-cast -Werror=overflow

CFLAGS        = $(CC_ARCH_SPEC) $(CC_INCLUDE) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(CC_WARNING) $(TSS_DEFINES) $(DBGFLAGS)
#ZeusMLKPre mfp_archi_merge 2011.03.25 triarc 渡邊 start
#C++FLAGS      = $(CC_ARCH_SPEC) $(CC_INCLUDE) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(C++_WARNING) $(TSS_DEFINES) -fno-for-scope
C++FLAGS      = $(CC_ARCH_SPEC) $(CC_INCLUDE) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(C++_WARNING) $(TSS_DEFINES) $(DBGFLAGS) -fno-for-scope
#ZeusMLKPre mfp_archi_merge 2011.03.25 triarc 渡邊 end
ifeq ($(DEBUGMODE), YES)
C++FLAGS      += $(DBGFLAGS)
endif

CFLAGS_AS     = $(CC_ARCH_SPEC) $(CC_INCLUDE) $(CC_OPTIM_TARGET) $(TSS_DEFINES)  $(DBGFLAGS) -P -x assembler-with-cpp

CFLAGS_LIB    = -fPIC

ifeq ($(COSIM), YES)
DBG_FLAG = -g -O0
else
#DBG_FLAG = -O2
DBG_FLAG = -g -O0
endif

ifeq ($(BASETYPE),all)
 TSS_DEFINES	+= -DCPU=$(CPU) -DTORNADO -DDEF_COLOR -DDEF_LITTLEENDIAN -DLINUX
else
ifeq ($(CROSS_COMPILE),mv78460-linux-)
