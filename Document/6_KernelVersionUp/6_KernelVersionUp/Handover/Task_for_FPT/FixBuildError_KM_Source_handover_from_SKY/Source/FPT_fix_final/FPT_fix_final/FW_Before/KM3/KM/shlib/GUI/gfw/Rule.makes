C++DEFS			+= -DDEF_MoselBoard
C++DEFS			+= -DDEF_MoselCom
C++DEFS			+= -DDEF_PANELDRV
C++DEFS			+= -DDEF_THAMES_I
C++DEFS			+= -DLINUX
C++DEFS			+= -DQT_PANEL
C++DEFS			+= -DTORNADO
C++DEFS			+= -DTORV22

ifeq ($(OEM_TYPE),SINDOH)
C++DEFS			+= -DDEF_SINDOH_CUS
endif

ifeq ($(OEM_TYPE),MURATAKIKAI)
C++DEFS			+= -DDEF_MURATA_CUS
endif

ifeq ($(AIRPRINT_DEF),yes)
C++DEFS	   += -DAIRPRINT_CUS
endif

ifeq ($(LCDTYPE),7inch)
C++DEFS			+= -DDEF_LCD_7INCH
endif

ifeq ($(RESTYPE),WQVGA)
C++DEFS			+= -DDEF_RES_WQVGA
else
ifeq ($(RESTYPE),WSVGA)
# 2019/02/19 OP_BTS-2076 LocalUI東島 IT6機種では3ペイン表示のためWVGAで画面表示制御を行っている.
# そのためmmlk(IT5機種)を除きIT6機種ではDEF_RES_WSVGAを定義しないように対応.
 ifeq ($(IT4MACHINE_TYPE),mmlk)
  C++DEFS	+= -DDEF_RES_WSVGA
 endif
else
ifeq ($(RESTYPE),FullHD)
C++DEFS			+= -DDEF_RES_FHD
else
ifeq ($(RESTYPE),WXGA)
C++DEFS			+= -DDEF_RES_WXGA
endif
endif
endif
endif


# ENDIAN
ifeq ($(BASETYPE),all)
C++DEFS		+= -DDEF_LITTLEENDIAN -Wno-error=unused-but-set-variable
else
ifeq ($(CROSS_COMPILE),mv78460-linux-)
C++DEFS			+= -DDEF_LITTLEENDIAN
else
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
C++DEFS			+= -DDEF_LITTLEENDIAN
else
ifeq ($(CROSS_COMPILE),mb86s72-linux-)
C++DEFS		+= -DDEF_LITTLEENDIAN
else
ifeq ($(CROSS_COMPILE),mv62x0-linux-)
C++DEFS		+= -DDEF_LITTLEENDIAN
else
ifeq ($(CROSS_COMPILE),s800-linux-)
C++DEFS		+= -DDEF_LITTLEENDIAN
else
C++DEFS		+= -DDEF_BIGENDIAN
endif
endif
endif
endif
endif
endif

# GFW_DEBUG_LOGを定義すると、デバッグログ出力あり

C++FLAGS		= $(C++PARAMS) $(C++INCS) $(C++DEFS)

ifeq ($(ADDRESS_SANITIZER),YES)
C++FLAGS	+= -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

CPPCHECK_FLAGS		= $(C++INCS) $(C++DEFS) -D__linux -D__linux__ -D__GNUC__

LDFLAGS			= -Wl,--relax -lstdc++ -pthread -lrt -lgcc_s
ifeq ($(QTVERSION),q530)
LIBS  			= -L$(QTDIR)/lib -lQt5Core -lQt5Gui -lQt5Network -lQt5KMOpenGLPainters -lQt5Svg
else
LIBS			= -L$(QTDIR)/lib -lQtCore -lQtGui -lQtNetwork
endif
LIBS		   += -L$(EXECFILEPATH)/km/fw/lib -lpddfont -lpddtext \
				  -lpddgrap -lqtconnecter -liType -lplibl -lfile -lpow -llogw -losw -lCharCodeConv -ldiv_client -ldiv_common -lJobSpec -lPrfApi -lset -lATS -lcomb -lsysdb -lLedBuzzer -lLstCustomize -lsst -lfilenameapl -lnvram
