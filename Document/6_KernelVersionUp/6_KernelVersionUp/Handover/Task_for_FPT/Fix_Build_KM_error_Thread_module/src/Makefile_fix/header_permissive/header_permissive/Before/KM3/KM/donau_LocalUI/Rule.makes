# Rule.makes

###############################################################################
##  $(COSIM)取り込み
include $(BASEPATH)/rule_sw.makes
include $(TOPPATH)/application/app/Rule_api.makes

###############################################################################
## GNU compilation tools definitions for PowerPC 604 

ifeq ($(COSIM), YES)
 CPU             = PPC603
else
 ifeq ($(CROSS_COMPILE),mpc8536-linux-)
  CPU             = PPC85XX
 else
  ifeq ($(CROSS_COMPILE),ppc440-linux-)
   CPU             = PPC440
  else
   ifeq ($(CROSS_COMPILE),mv78460-linux-)
    CPU             = MV78460
   else
   ifeq ($(CROSS_COMPILE),mb86s73-linux-)
    CPU             = MB86S73
   else
     ifeq ($(CROSS_COMPILE),mb86s72-linux-)
      CPU             = MB86S72
     else
   ifeq ($(CROSS_COMPILE),mv62x0-linux-)
    CPU             = MV62X0
   else
    ifeq ($(CROSS_COMPILE),ppc5020-linux-)
	 CPU             = PPC440
	else
	 CPU             = PPC604
    endif
   endif
   endif
   endif
  endif
 endif
 endif
endif

DF_TYPE				= EDH
# PIC
ifeq ($(COSIM), YES)
 INCLUDE_PIC	=	NO
else
 INCLUDE_PIC	=	YES
endif

# NICFUM
ifeq ($(COSIM), YES)
 INCLUDE_MIO     = NO
else
 ifeq ($(BASETYPE),all)
  INCLUDE_MIO     = NO
 else
  INCLUDE_MIO     = YES
 endif
endif

# Network-FAX(2006.05.23 松尾 有効化)
NETFAX          = YES

# ThamesCus削除対応(2007.05.29 松尾)
IOPTIONCOM      = YES

# 以下、システムデバッグ用変更しちゃダメ (x_x) 
ifeq ($(COSIM), YES)
 IEEE1284_INTERFACE = NO
 USB20_INTERFACE    = NO
else
 IEEE1284_INTERFACE = NO
 ifeq ($(BASETYPE), hw)
  USB20_INTERFACE    = YES
 else
  USB20_INTERFACE    = NO
 endif
endif

# ROM分割有効 
ifeq ($(COSIM), YES)
 ROM_DIV   = NO
 ROM_DIV_2 = NO
 ROM_DIV_3 = NO
else
 ROM_DIV   = YES
 ROM_DIV_2 = YES
 ROM_DIV_3 = YES
endif

#AESFTP送信を無効
AES_FTP_OFF = NO

ifeq ($(COSIM), NO)
 export BioModuleVer = v4_0
 # AU102_V1_0 専用静紋USBデバイス対応 
 export BioModule2ndVer = AU102_V1_0
endif

# Authモジュールライブラリ
# 課金ライブラリはLocalUI側には不要なので YES → NO に変更
# (2011/01/31 LocalUIリンクエラー対応)
ifeq ($(BASETYPE),all)
 AUTH_LIB	= NO
else
 AUTH_LIB	= YES
endif

# OSラッパーシェアードライブラリ化
ifeq ($(BASETYPE),all)
 OSWRAPPER_LIB	= YES
else
 OSWRAPPER_LIB	= YES
endif

# RSAシェアードライブラリ化
RSA_LIB = YES

# PDF動的ライブラリ
ifeq ($(OSWRAPPER_LIB), YES)
 HGPDF_LIB = YES
else
 HGPDF_LIB = NO
endif

# プロセス間共有領域管理(管理ライブラリ) シェアードライブラリ化
MNG_LIB	= YES

# Emperor用シェアードライブラリ
FOREMP_LIB	= NO

ifeq ($(XWINDOW_ENABLE), YES)
 TSS_DEFINES   += -DXWINDOW_ENABLE
endif

# Emperor RIPパフォーマンス測定
EMPRIPPERFORM	= NO

# 一元管理対応の設定 
ifeq ($(BUILD_TASK_MANAGER), YES)
 TSS_DEFINES		+= -DDEF_TASK_MANAGER
endif

ifeq ($(EMPRIPPERFORM), YES)
 TSS_DEFINES   += -DEMPRIPPERFORM
endif

# ソフトパフォーマンス測定
SOFTWARE_PERFORM	= NO

ifeq ($(SOFTWARE_PERFORM), YES)
 TSS_DEFINES   += -DSOFTWARE_PERFORMANCE_DBG
endif

ifeq ($(CROSS_COMPILE),ppc440-linux-)

 # Resident拡張対応
 # CQ.377871　MS-EVU_19  kernelメモリマップ.
 #RESIDENT_EXPANSION = YES
 RESIDENT_EXPANSION  = NO

 ifeq ($(RESIDENT_EXPANSION), YES)
  TSS_DEFINES   += -DRESIDENT_EXPANSION
  CC_INCLUDE    += -I$(COMMONPATH)/../../shlib/ResidentTLBLib
 endif

 #2013/03/05 MV78460暫定対応
 ifeq ($(CROSS_COMPILE),mv78460-linux-)
  #アーキテクチャがARMの場合に使用
  CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
 endif
 ifeq ($(CROSS_COMPILE),mb86s73-linux-)
  #アーキテクチャがARMの場合に使用
  CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
 endif
 ifeq ($(CROSS_COMPILE),mb86s72-linux-)
  #アーキテクチャがARMの場合に使用
  CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
 endif
 ifeq ($(CROSS_COMPILE),mv62x0-linux-)
  #アーキテクチャがARMの場合に使用
  CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
 endif
endif

# プロセス分離環境設定
EMPPROCESS_DIVIDE = NO

# LogFum環境ビルド
LOGFUM_BUILD = NO

# Section preload
SECTION_PRELOAD = YES

# //@ 2011.7.19 tri oisi modify(UI make対応) ->
# NUIAPI使用設定
NUI_SW = NO
# //@ 2011.7.19 tri oisi modify(UI make対応) <-
# //@ 2011.6.8 tri oisi modify(UI make対応) ->
# NUIAPI CT環境設定
NUI_CT_SW = NO
# //@ 2011.6.8 tri oisi modify(UI make対応) <-

ifeq ($(TLOGLIB_BUILD), YES)
 TSS_DEFINES   += -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
endif

# DRAG_FUNCTION_ON のスイッチ.
DRAG_FUNC_SW = YES

ifeq ($(EMPPROCESS_DIVIDE), YES)
 TSS_DEFINES   += -DINCLUDE_EMPEROR_IPC
 FOREMP_LIB	= YES
 export SHLIBOBJPATH := $(OBJPATH_BASE)
 export EMPOBJPATH := $(OBJPATH_BASE)/emp
 export OBJPATH := $(OBJPATH_BASE)/mfp
endif

ifeq ($(LOGFUM_BUILD), YES)
 export LGPOBJPATH := $(LOGFUMPATH)/LogProcess
endif


ifeq ($(BASETYPE),all)
 CC_OPTIM_TARGET = -fno-builtin -fno-inline -fsigned-char 
else
 CC_OPTIM_TARGET = -O2 -fno-builtin -fno-inline -fsigned-char 
endif

ifeq ($(COSIM), YES)
 CC_ARCH_SPEC    = -mcpu=603 -mstrict-align -mlongcall
 CC_ARCH_DEFS    = -DCPU_ARCH_PPC
else
 ifeq ($(BASETYPE),all)
  CC_ARCH_DEFS    =                           -DINET6
 else
  ifeq ($(CROSS_COMPILE),mpc8536-linux-)
   CC_ARCH_SPEC    = -mstrict-align -mlongcall
  CC_ARCH_DEFS    = -DCPU_ARCH_PPC -DINET6
  else
   ifeq ($(CROSS_COMPILE),ppc440-linux-)
    CC_ARCH_SPEC    = -mstrict-align -mlongcall
  CC_ARCH_DEFS    = -DCPU_ARCH_PPC -DINET6
   else
    ifeq ($(CROSS_COMPILE),mv78460-linux-)
     CC_ARCH_SPEC	= -mcpu=marvell-pj4b -mfpu=vfpv3 -mabi=aapcs-linux -mlittle-endian -fwrapv
  CC_ARCH_DEFS    = -DCPU_ARCH_PPC -DINET6
     #MV78460暫定対応用のフラグ作成(Makefile用)
     MV78460_MAKE_TEMP = YES
    else
    ifeq ($(CROSS_COMPILE),mb86s73-linux-)
     CC_ARCH_SPEC	= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -funwind-tables
  CC_ARCH_DEFS    = -DCPU_ARCH_PPC -DINET6
     #暫定対応用のフラグ作成(Makefile用)
     MV78460_MAKE_TEMP = YES
    else
      ifeq ($(CROSS_COMPILE),mb86s72-linux-)
       CC_ARCH_SPEC	= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations
  CC_ARCH_DEFS    = -DCPU_ARCH_ARM -DINET6
       #暫定対応用のフラグ作成(Makefile用)
       MV78460_MAKE_TEMP = YES
      else
        ifeq ($(CROSS_COMPILE),s800-linux-)
         CC_ARCH_SPEC			= -fwrapv -funwind-tables -D_ARM_BSP_STRONG_ORDERING_ -DDEF_64BIT_PF
         CC_ARCH_DEF			= -DINET6
         MV78460_MAKE_TEMP = YES
	else
          ifeq ($(CROSS_COMPILE),mv62x0-linux-)
	  CC_ARCH_SPEC	= -mcpu=cortex-a7 -mthumb-interwork -mfloat-abi=hard -mfpu=vfpv4-d16 -mthumb -mlong-calls -mlittle-endian -funwind-tables -mtls-dialect=gnu
	  CC_ARCH_DEFS    = -DCPU_ARCH_ARM -DINET6
	  #暫定対応用のフラグ作成(Makefile用)
          MV78460_MAKE_TEMP = YES
	  else
       CC_ARCH_SPEC    = -mcpu=604 -mstrict-align -mlongcall
  CC_ARCH_DEFS    = -DCPU_ARCH_PPC -DINET6
	  endif
    	endif
    endif
   endif
  endif
 endif
 endif
endif
endif

ifeq ($(ADDRESS_SANITIZER),YES)
CC_ARCH_SPEC +=  -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

AR          = $(CROSS_COMPILE)ar
AS          = $(CROSS_COMPILE)as
CC          = $(CROSS_COMPILE)gcc
CF          =
CP          = cp
LD          = $(CROSS_COMPILE)ld
LDOUT_CONV  = @rem
LDOUT_SYMS  = @rem
NM          = $(CROSS_COMPILE)nm
SIZE        = $(CROSS_COMPILE)size
RANLIB      = $(CROSS_COMPILE)ranlib
RM          = rm

ARCH_DIR        = ppc

CPP             = $(CC) -E -P -xc

LDFLAGS          	= -X -N -Map DonauBoot.map

###############################################################################
# depend名設定
ifeq ($(COSIM), YES)
 ifeq ($(THR_SIMWIN), YES)
  DEPEND_INC       	:= _cosim_thrsim.depend
 else
  DEPEND_INC       	:= _cosim.depend
 endif
else
 ifeq ($(PRODUCT_TYPE), EMU)
  DEPEND_INC       	:= _emu.depend
 endif

 ifeq ($(PRODUCT_TYPE), DONAU)
  DEPEND_INC       	:= _doanu.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),Minerva)
  DEPEND_INC		= _minerva.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),MinervaBK)
  TSS_DEFINES	   += -DDEF_MinervaBKCus -DDEF_MonoCus
  DEPEND_INC		= _minervabk.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),Zeus)
  TSS_DEFINES	   += -DDEF_ZeusCus
  DEPEND_INC		= _zeus.depend
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeus)
	TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard
	ifeq ($(BUILD_CORE),amp0)
	 DEPEND_INC		= _SoCZeus_amp0.depend
	else
	 ifeq ($(BUILD_CORE),amp1)
	  DEPEND_INC		= _SoCZeus_amp1.depend
	 else
	  DEPEND_INC		= _SoCZeus_single.depend
	 endif
	endif
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeusEmu)
  TSS_DEFINES	   += -DDEF_ZeusEmu -DDEF_Soc1200
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCZeusEmu_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCZeusEmu_amp1.depend
   else
    DEPEND_INC		= _SoCZeusEmu_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),MinervaEmu)
  TSS_DEFINES	   += -DDEF_MinervaEmu
  DEPEND_INC		= _minervaemu.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),MinervaBKEmu)
  TSS_DEFINES	   += -DDEF_MinervaBKEmu -DDEF_MonoCus
  DEPEND_INC		= _minervabkemu.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),ZeusEmu)
  TSS_DEFINES	   += -DDEF_ZeusEmu
  DEPEND_INC		= _zeusemu.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),DonauLinux)
  TSS_DEFINES	   += -DDEF_MinervaPreEmu
  DEPEND_INC		= _donaulinux.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),ZeusRevEmu)
  TSS_DEFINES	   += -DDEF_ZeusRevCus
  DEPEND_INC		= _zeusrevemu.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),SoCDonauEmu)
  TSS_DEFINES	   += -DDEF_MinervaEmu -DDEF_Soc1200
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCDonauEmu_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCDonauEmu_amp1.depend
   else
    DEPEND_INC		= _SoCDonauEmu_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeusEmu2ndAmur)
  TSS_DEFINES	   += -DDEF_ZeusEmu -DDEF_ZeusMLKEmu -DDEF_Soc1200 -DDEF_ZeusMLKBoard
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCZeusEmu2ndAmur_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCZeusEmu2ndAmur_amp1.depend
   else
    DEPEND_INC		= _SoCZeusEmu2ndAmur_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeusEmu2ndZeus)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKEmu -DDEF_Soc1200 -DDEF_ZeusMLKBoard
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCZeusEmu2ndZeus_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCZeusEmu2ndZeus_amp1.depend
   else
    DEPEND_INC		= _SoCZeusEmu2ndZeus_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),ZeusBKPreEmu)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusBKEmu -DDEF_MonoCus
  DEPEND_INC		= _zeusBKPreEmu.depend
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeusBKEmu)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKEmu -DDEF_ZeusBKEmu -DDEF_Soc1200 -DDEF_MonoCus -DDEF_ZeusMLKBoard
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCZeusBKEmu_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCZeusBKEmu_amp1.depend
   else
    DEPEND_INC		= _SoCZeusBKEmu_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),SoCZeusBK)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_MonoCus -DDEF_ZeusMLKBoard
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC		= _SoCZeusBK_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC		= _SoCZeusBK_amp1.depend
   else
    DEPEND_INC		= _SoCZeusBK_single.depend
   endif
  endif
 endif

 ifeq ($(IT4MACHINE_TYPE),arxp)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_ARMADAXP -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _arxp.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),he2)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HELIOS_EMU2 -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _he2.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),z5be2)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HELIOS_EMU2 -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MonoCus -DDEF_Zeus5BkCus
  DEPEND_INC		= _z5be2.depend
 endif
 ifeq ($(IT4MACHINE_TYPE),z5be3)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),z5b)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zse3)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_ZEUSS_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zse3_a4)
  TSS_DEFINES	   += -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),vmlk)
  TSS_DEFINES	   += -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),vmlke)
  TSS_DEFINES	   += -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_A4_Cus_EMU_A3
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),vmlkeve)
  TSS_DEFINES	   += -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_A4_Cus_EMU_Venus
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zs)
  TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_ZEUSS_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_EaglePanel_Low
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zsb)
  TSS_DEFINES	   += -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK12_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ZeusMLKCus -DDEF_ZEUSS_CUS
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zsbx)
  TSS_DEFINES	   += -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBKX0_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusMLKCus 
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zsbe)
  TSS_DEFINES	   += -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK12_CUS -DDEF_ZEUSS_BASE_EMU -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ZeusMLKCus -DDEF_ZEUSS_CUS
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
  ifeq ($(IT4MACHINE_TYPE),zsb2)
  TSS_DEFINES	   += -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK2ND_12_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ZeusMLKCus -DDEF_ZEUSS_CUS
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),zsb2z)
  TSS_DEFINES	   += -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK2ND_ZX0_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusMLKCus 
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
 endif
 ifeq ($(IT4MACHINE_TYPE),msb)
  TSS_DEFINES	   += -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_MINERVASBK_CUS -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS
  DEPEND_INC		= _$(IT4MACHINE_TYPE).depend
