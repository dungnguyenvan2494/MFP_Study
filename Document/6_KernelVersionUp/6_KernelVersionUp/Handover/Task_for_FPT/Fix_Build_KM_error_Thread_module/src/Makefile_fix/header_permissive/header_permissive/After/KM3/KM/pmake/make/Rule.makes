endif

ifeq ($(CROSS_COMPILE),s800-linux-)
	CC_MV78460_TEMP = -DMV78460_TEMPORARY
	CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
endif
ifeq ($(CROSS_COMPILE),x86_64-linux-)
	CC_MV78460_TEMP = -DMV78460_TEMPORARY
endif

ifeq ($(CROSS_COMPILE),mv62x0-linux-)
 #暫定対応用のフラグ作成(ソースコード用)
 CC_MV78460_TEMP = -DMV78460_TEMPORARY

 #アーキテクチャがARMの場合に使用
