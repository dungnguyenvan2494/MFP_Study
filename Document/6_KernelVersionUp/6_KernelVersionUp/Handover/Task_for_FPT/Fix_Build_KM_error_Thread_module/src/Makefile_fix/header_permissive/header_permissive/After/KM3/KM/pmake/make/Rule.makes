  ifeq ($(IT4MACHINE_TYPE),zsbe800)
   CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
  else
   ifeq ($(IT4MACHINE_TYPE),zse800)
    CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
   else
    ifeq ($(IT4MACHINE_TYPE),zsbe800zx)
     CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
    else
     ifeq ($(IT4MACHINE_TYPE),zse800zx)
      CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
     else
      ifeq ($(IT4MACHINE_TYPE),egl)
       CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
      else
       ifeq ($(IT4MACHINE_TYPE),eglz)
        CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
       else
        ifeq ($(IT4MACHINE_TYPE),dnbmlk)
         CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
        else
         ifeq ($(IT4MACHINE_TYPE),dnbmlke800)
          CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
         else
          ifeq ($(IT4MACHINE_TYPE),eglb)
           CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
          else
           ifeq ($(IT4MACHINE_TYPE),eglbz)
            CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
           else
            ifeq ($(IT4MACHINE_TYPE),eglbee)
             CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
            else
             ifeq ($(IT4MACHINE_TYPE),eglbzee)
              CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
             else
              ifeq ($(IT4MACHINE_TYPE),eglbe800)
               CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
              else
               ifeq ($(IT4MACHINE_TYPE),eglbze800)
                CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
               else
                ifeq ($(IT4MACHINE_TYPE),spam)
                 CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                else
                 ifeq ($(IT4MACHINE_TYPE),spaaiosfp)
                  CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                 else
                  ifeq ($(IT4MACHINE_TYPE),zse800spa)
                   CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                  else
                   ifeq ($(IT4MACHINE_TYPE),zse800spa7)
                    CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                   else
                    ifeq ($(IT4MACHINE_TYPE),spamb)
                     CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                    else
                     ifeq ($(IT4MACHINE_TYPE),spaaiosfpb)
                      CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                     else
                      ifeq ($(IT4MACHINE_TYPE),esspamb)
                       CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                      else
                       ifeq ($(IT4MACHINE_TYPE),esspaaiosfpb)
                        CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                       else
                        ifeq ($(IT4MACHINE_TYPE),zse800spab)
                         CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                        else
                         ifeq ($(IT4MACHINE_TYPE),zse800spa7b)
                          CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
                         else
	                  ifeq ($(IT4MACHINE_TYPE),eglzp)
	                   CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                  else
	                   ifeq ($(IT4MACHINE_TYPE),eglbzp)
	                    CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                   else
	                    ifeq ($(IT4MACHINE_TYPE),eglzpee)
	                     CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                    else
	                     ifeq ($(IT4MACHINE_TYPE),eglbzpee)
	                      CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                     else
	                      ifeq ($(IT4MACHINE_TYPE),eglzpe800)
	                       CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                      else
	                       ifeq ($(IT4MACHINE_TYPE),eglbzpe800)
	                        CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                       else
	                        ifeq ($(IT4MACHINE_TYPE),hemlk)
	                         CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                        else
	                         ifeq ($(IT4MACHINE_TYPE),hemlkee)
	                          CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                         else
	                          ifeq ($(IT4MACHINE_TYPE),hemlke800)
	                           CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                          else
	                           ifeq ($(IT4MACHINE_TYPE),mssb)
	                            CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                           else
	                            ifeq ($(IT4MACHINE_TYPE),mssbee)
	                             CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllIt6/Dll
	                            else
 	                             CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllZeusS/Dll
 	                             SIMLIN_IT6	=	NO
                                    endif
                                   endif
                                  endif
                                 endif
                                endif
                               endif
                              endif
                             endif
                            endif
                           endif
                          endif
                         endif
                        endif
                       endif
                      endif
       	             endif
                    endif
                   endif
                  endif
                 endif
                endif
               endif
              endif
             endif
            endif
           endif
          endif
         endif
        endif
       endif
      endif
     endif
    endif
   endif
  endif
 else
  SIMLIN_IT6	=	NO
  ifeq ($(THRMACHINE_TYPE),ZeusSA4)
   CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllZeusS/Dll
  else
   ifeq ($(THRMACHINE_TYPE),VenusMLK)
    CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllZeusS/Dll
   else
    ifeq ($(THRMACHINE_TYPE),KronosS)
     CC_INCLUDE	+=	-I$(TOPPATH)/simulator/AsicDrvrDllZeusS/Dll
    else
     CC_INCLUDE	+=	-I$(TOPPATH)/simulator/SimAsicDll/Dll
    endif
   endif
  endif
 endif
 ifneq ($(SIMLIN_IT6),NO)
  TSS_DEFINES	+=	-DFUM_SIMLINMC
 endif
endif

# WebROM
ifeq ($(WEBROM),e)
 TSS_DEFINES		+= -DDEF_WebBrowserROM
 DEPEND_INC      := _web$(DEPEND_INC)
endif

# HDDレス制御
# DEF_Soc1200が存在の場合のみ有効
ifneq ($(findstring DDEF_Soc1200,$(TSS_DEFINES)),)
 TSS_DEFINES		+= -DDEF_FUM_HDDLess_Enable
endif

C++FLAGS                = $(C++PARAMS) $(C++INCS) $(C++DEFS)
CPPCHECK_FLAGS          = $(C++INCS) $(C++DEFS) -D__linux -D__linux__ -D__GNUC__

ifeq ($(IT4MACHINE_TYPE),kssfum)
 ifeq ($(BASETYPE),all)
  SIM_IRMDBG		=	YES
 endif
endif
ifeq ($(IT4MACHINE_TYPE),kss)
 ifeq ($(BASETYPE),all)
  SIM_IRMDBG		=	YES
 endif
endif

ifeq ($(SIM_IRMDBG),YES)
 TSS_DEFINES		+=	-DDBG_IRMSIM
endif
# SetUpTool
TSS_DEFINES		+= -DDCSW_DEVELOP_SETUPTOOL
# 7inch用パネル.
ifeq ($(LCDTYPE),7inch)
TSS_DEFINES	+= -DDEF_LCD_7INCH
endif
