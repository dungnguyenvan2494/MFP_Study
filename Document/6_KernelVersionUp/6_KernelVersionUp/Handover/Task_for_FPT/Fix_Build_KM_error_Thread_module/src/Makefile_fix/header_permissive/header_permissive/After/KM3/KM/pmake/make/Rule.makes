endif

ifeq ($(BASETYPE),all)
 CFLAGS        = $(CC_ARCH_SPEC) $(CC_ARCH_DEF) $(CC_INCLUDE) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(CC_WARNING) $(TSS_DEFINES) -funwind-tables
 C++PARAMS     = $(CC_ARCH_SPEC) $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
 C++INCS       = $(CC_INCLUDE)
 C++DEFS       = $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 CFLAGS_AS     = $(CC_ARCH_SPEC) $(CC_ARCH_DEF) $(CC_INCLUDE) $(CC_OPTIM_TARGET) $(TSS_DEFINES) -P -x assembler-with-cpp
else
 CFLAGS        = $(CC_ARCH_SPEC) $(CC_ARCH_DEF) $(CC_INCLUDE) -nostdinc -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(CC_WARNING) $(TSS_DEFINES)
 ifeq ($(CROSS_COMPILE),mv78460-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mb86s73-linux-)
  CFLAGS       += -funwind-tables 
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mb86s72-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),s800-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mv62x0-linux-)
  CFLAGS       += -funwind-tables
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEF) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 endif
 endif
 endif
 endif
 endif
 CFLAGS_AS     = $(CC_ARCH_SPEC) $(CC_ARCH_DEF) $(CC_INCLUDE) -nostdinc $(CC_OPTIM_TARGET) $(TSS_DEFINES) -P -x assembler-with-cpp
endif

#リファクタリングPh1 OPS1 KM 大迫 2014/8/19 CQ501394/Act_501412
#上位システム層のみfno-for-scope⇒ffor-scopeにコンパイルオプション変更
#（全体適用の場合は、本変更を削除し、前C++FLAGS設定を更新すること）
