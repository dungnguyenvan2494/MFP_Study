				-I/opt/timesys/mpc8641_hpcn/toolchain/powerpc-timesys-linux-gnu/include/c++/4.3.3 \
				-I/opt/timesys/mpc8641_hpcn/toolchain/powerpc-timesys-linux-gnu/include/c++/4.3.3/powerpc-timesys-linux-gnu \
