# Rule.makes

###############################################################################
##  $(COSIM)取り込み
include $(BASEPATH)/rule_sw.makes

###############################################################################
## GNU compilation tools definitions 

ifeq ($(COSIM), YES)
 CPU             = PPC603
else
 ifeq ($(CROSS_COMPILE),mpc8536-linux-)
  CPU             = PPC85XX
 else
  ifeq ($(CROSS_COMPILE),ppc440-linux-)
   CPU             = PPC440
  else
   ifeq ($(CROSS_COMPILE),mv78460-linux-)
    CPU             = MV78460
   else
    ifeq ($(CROSS_COMPILE),mb86s73-linux-)
     CPU             = MB86S73
    else
     ifeq ($(CROSS_COMPILE),s800-linux-)
      CPU             = S800
     else
      ifeq ($(CROSS_COMPILE),ppc5020-linux-)
       CPU             = PPC440
      else
       ifeq ($(CROSS_COMPILE),mb86s72-linux-)
        CPU             = MB86S72
       else
        ifeq ($(CROSS_COMPILE),mv62x0-linux-)
         CPU             = MV62X0
        else
         CPU             = PPC604
        endif
       endif
      endif
     endif
    endif
   endif
  endif
 endif
endif

###############################################################################
## Module Setting 

#### EDH or ADF #######
DF_TYPE				= EDH

# PIC NICFUM
ifeq ($(COSIM), YES)
 INCLUDE_PIC	= NO
 INCLUDE_MIO	= NO
else
 INCLUDE_PIC	= YES
 INCLUDE_MIO	= YES
endif

# IRC
ifeq ($(COSIM), YES)
INCLUDE_IRC	=	NO
else
INCLUDE_IRC	=	YES
endif

# Network-FAX
NETFAX          = YES

# ThamesCus削除対応
IOPTIONCOM      = YES

# 以下、システムデバッグ用変更しちゃダメ (x_x) 
ifeq ($(COSIM), YES)
 IEEE1284_INTERFACE = NO
 USB20_INTERFACE    = NO
else
 IEEE1284_INTERFACE = NO
 ifeq ($(BASETYPE), hw)
  USB20_INTERFACE    = YES
 else
  USB20_INTERFACE    = NO
 endif
endif

# ROM分割有効 
ifeq ($(COSIM), YES)
 ROM_DIV   = NO
 ROM_DIV_2 = NO
 ROM_DIV_3 = NO
else
 ROM_DIV   = YES
 ROM_DIV_2 = YES
 ROM_DIV_3 = YES
endif

#AESFTP送信を無効
AES_FTP_OFF = NO

# 生体認証モジュール 組込みバージョン選択 
#   バージョン名 = フォルダ名となっている(ex. KM/common/AuthDev/bioModule/v2_1等)
# v2.1 従来バージョン 
#export BioModuleVer = v2_1
# v3.0 専用静紋USBデバイス対応 
#export BioModuleVer = v3_0
# v3.1 専用静紋USBデバイス対応(mlongcall対応版) 
#export BioModuleVer = v3_1
# v3.2 専用静紋USBデバイス対応 
#export BioModuleVer = v3_2
# v4.0 専用静紋USBデバイス対応 
ifeq ($(COSIM), NO)
export BioModuleVer = v4_0
# AU102_V1_0 専用静紋USBデバイス対応 
#export BioModule2ndVer = AU102_V1_0
# AU102_V1_0 Linux版 専用静紋USBデバイス対応
export BioModule2ndVer = AU102_LINUX

endif

# Authモジュールライブラリ
ifeq ($(BASETYPE),all)
 AUTH_LIB	= NO
else
 AUTH_LIB	= YES
endif

# OSラッパーシェアードライブラリ化
OSWRAPPER_LIB	= YES

# WebKitBrowser library
BRW_LIB = YES

# RSAシェアードライブラリ化
RSA_LIB = YES

# OPENSSLライブラリ NICFUM7.6
OPENSSL_LIB = YES

# LibP11ライブラリ NICFUM7.6
LIBP11_LIB = YES

# PDF動的ライブラリ
ifeq ($(OSWRAPPER_LIB), YES)
 HGPDF_LIB = YES
else
 HGPDF_LIB = NO
endif

# プロセス間共有領域管理(管理ライブラリ) シェアードライブラリ化
MNG_LIB	= YES

# Emperor用シェアードライブラリ
FOREMP_LIB	= NO

# MTPライブラリ
MTP_LIB = YES

ifeq ($(XWINDOW_ENABLE), YES)
 TSS_DEFINES   += -DXWINDOW_ENABLE
endif

#NODE-BLACK TEST TOOLS
ifeq ($(DEF_NODEBLACK_TEST),YES)
 TSS_DEFINES   += -DDEF_NODEBLACK_TEST
endif

# Emperor RIPパフォーマンス測定
EMPRIPPERFORM	= NO

ifeq ($(EMPRIPPERFORM), YES)
 TSS_DEFINES   += -DEMPRIPPERFORM
endif

# ソフトパフォーマンス測定
SOFTWARE_PERFORM	= YES

ifeq ($(SOFTWARE_PERFORM), YES)
 TSS_DEFINES   += -DSOFTWARE_PERFORMANCE_DBG
endif

ifeq ($(CROSS_COMPILE),ppc440-linux-)
 # Resident拡張対応
 # CQ.377871　MS-EVU_19  kernelメモリマップ.
 #RESIDENT_EXPANSION = YES
 RESIDENT_EXPANSION  = NO

 ifeq ($(RESIDENT_EXPANSION), YES)
  TSS_DEFINES   += -DRESIDENT_EXPANSION
  CC_INCLUDE    += -I$(TOPPATH)/shlib/ResidentTLBLib
 endif
 #AMP対応(コア毎のコンパイルスイッチ定義)
 ifneq ($(BUILD_CORE),single)
  TSS_DEFINES   += -DSOC_AMP
  ifeq ($(BUILD_CORE),amp1)
   TSS_DEFINES   += -DSOC_AMP_CORE1
  endif
 endif
endif


# プロセス分離環境設定
EMPPROCESS_DIVIDE = NO

# LogFum環境ビルド
LOGFUM_BUILD = YES

# EmperorSim対応
# 2015/02/23 BSKK S.Kuratomi mod start (CQ509837).
# ifeq ($(BASETYPE),all)
#  EMPERORSIM_BUILD = YES
# else
 EMPERORSIM_BUILD = NO
# endif
# 2015/02/23 BSKK S.Kuratomi mod end (CQ509837).
# CombFum環境ビルド
COMBFUM_BUILD = YES

# FileNameFum環境ビルド
FILENAMEFUM_BUILD = YES

ifeq ($(TLOGLIB_BUILD), YES)
 TSS_DEFINES   += -DIS_PEFORMANCE_LAP_TIME_OUTPUT_FLAG
endif

ifeq ($(EMPPROCESS_DIVIDE), YES)
 TSS_DEFINES   += -DINCLUDE_EMPEROR_IPC
 FOREMP_LIB	= YES
 export SHLIBOBJPATH := $(OBJPATH_BASE)
 export EMPOBJPATH := $(OBJPATH_BASE)/emp
 export OBJPATH := $(OBJPATH_BASE)/mfp
endif

ifeq ($(LOGFUM_BUILD), YES)
 export LGPOBJPATH := $(LOGFUMPATH)/LogProcess
endif

#デフォルト値の設定
VOICEGUIDE_BUILD = YES
MV78460_MAKE_TEMP = NO

# 2013/06/10【CQ.379467】制御構成変更_No.1200,1220対応
AUDIOFUNCTION_BUILD = YES

# 一元管理対応の設定 
ifeq ($(BUILD_TASK_MANAGER), YES)
 TSS_DEFINES		+= -DDEF_TASK_MANAGER
 # pthread_hook build
 PTHOOKLIB_BUILD = YES
endif

# DBMSの格納先設定
# 編集データの格納先設定
ifeq ($(CROSS_COMPILE),s800-linux-)
 ifneq ($(IT4MACHINE_TYPE), a64_mv7040)
  TSS_DEFINES	+= -DDEF_DBMS_MOUNT_ATA0J -DDEF_EDITDATA_MOUNT_ATA0J
 endif
else
 ifeq ($(CROSS_COMPILE),x86_64-linux-)
  TSS_DEFINES	+= -DDEF_DBMS_MOUNT_ATA0J -DDEF_EDITDATA_MOUNT_ATA0J
 endif
endif

###############################################################################
## GNU compilation tools definitions 

ifeq ($(BASETYPE),all)
 CC_OPTIM_TARGET = -fno-builtin -fno-inline -fsigned-char 
else
 CC_OPTIM_TARGET = -O2 -fno-builtin -fno-inline -fsigned-char 
endif

ifeq ($(COSIM), YES)
 CC_ARCH_SPEC    = -mcpu=603 -mstrict-align -mlongcall
 CC_ARCH_DEF    = -DCPU_ARCH_PPC
else
 ifeq ($(BASETYPE),all)
  CC_ARCH_DEF    =                                     -DINET6
 else
  ifeq ($(CROSS_COMPILE),mpc8536-linux-)
   CC_ARCH_SPEC    = -mstrict-align -mlongcall
   CC_ARCH_DEF    = -DCPU_ARCH_PPC -DINET6
  else
   ifeq ($(CROSS_COMPILE),ppc440-linux-)
    CC_ARCH_SPEC    = -mstrict-align -mlongcall
    CC_ARCH_DEF    = -DCPU_ARCH_PPC -DINET6
   else
    ifeq ($(CROSS_COMPILE),mv78460-linux-)
     CC_ARCH_SPEC	= -mcpu=marvell-pj4b -mfpu=vfpv3 -mabi=aapcs-linux -mlittle-endian -fwrapv
     CC_ARCH_DEF	= -DCPU_ARCH_ARM -DINET6
     #MV78460暫定対応用のフラグ作成(Makefile用)
     MV78460_MAKE_TEMP = YES
    else
     ifeq ($(CROSS_COMPILE),mb86s73-linux-)
      CC_ARCH_SPEC	= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian
      CC_ARCH_DEF	= -DCPU_ARCH_ARM -DINET6
      #暫定対応用のフラグ作成(Makefile用)
      MV78460_MAKE_TEMP = YES
     else
      ifeq ($(CROSS_COMPILE),mb86s72-linux-)
       CC_ARCH_SPEC	= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations
       CC_ARCH_DEF    = -DCPU_ARCH_ARM -DINET6
       #暫定対応用のフラグ作成(Makefile用)
       MV78460_MAKE_TEMP = YES
      else
       ifeq ($(CROSS_COMPILE),s800-linux-)
        CC_ARCH_SPEC			= -fwrapv -funwind-tables -D_ARM_BSP_STRONG_ORDERING_ -DDEF_64BIT_PF
        CC_ARCH_DEF			= -DINET6
        MV78460_MAKE_TEMP = YES
       else
        ifeq ($(CROSS_COMPILE),mv62x0-linux-)
         CC_ARCH_SPEC	= -mcpu=cortex-a7 -mthumb-interwork -mfloat-abi=hard -mfpu=vfpv4-d16 -mthumb -mlong-calls -mlittle-endian -funwind-tables -mtls-dialect=gnu -Wno-error=conversion-null -Wno-error=init-self -Wno-error=unused-local-typedefs -fno-aggressive-loop-optimizations
         CC_ARCH_DEF	= -DCPU_ARCH_ARM -DINET6
         #暫定対応用のフラグ作成(Makefile用)
         MV78460_MAKE_TEMP = YES
        else
         CC_ARCH_SPEC    = -mcpu=604 -mstrict-align -mlongcall
         CC_ARCH_DEF    = -DCPU_ARCH_PPC -DINET6
        endif
       endif
      endif
     endif
    endif
   endif
  endif
 endif
endif

AR          = $(CROSS_COMPILE)ar
AS          = $(CROSS_COMPILE)gcc
CC          = $(CROSS_COMPILE)gcc
CF          =
CP          = cp
LD          = $(CROSS_COMPILE)ld
LDOUT_CONV  = @rem
LDOUT_SYMS  = @rem
NM          = $(CROSS_COMPILE)nm
SIZE        = $(CROSS_COMPILE)size
RANLIB      = $(CROSS_COMPILE)ranlib
RM          = rm

ifeq ($(BASETYPE), hw)
 ARCH_DIR        = ppc
else
 ARCH_DIR        = i386
endif

CPP             = $(CC) -E -P -xc
LDFLAGS          	= -X -N -Map DonauBoot.map

