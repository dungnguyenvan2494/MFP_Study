#!/bin/bash
#
# KM setup 1st
#

case "$1" in
  start)
	echo "KM setup 1st: Start"
	# Setup R/W Ramdisk (/var)
	echo "KM setup 1st: Setup R/W Ramdisk (/var)"
	mount -n -t tmpfs -o noatime,size=64m tmpfs /var
	mkdir -p /var/lib
	mkdir -p /var/log
	mkdir -p /var/run/netreport
	mkdir -p -m 707 /var/spool/sockets
	mkdir -p /var/tmp
	# Reconstruction /etc
	echo "KM setup 1st: Reconstruction /etc"
	if [ -f /etc/init.d/setup_etc.sh ]; then
		/etc/init.d/setup_etc.sh
	fi
	echo "KM setup 1st: Done"
	;;
  *)
	;;
esac

exit $?
