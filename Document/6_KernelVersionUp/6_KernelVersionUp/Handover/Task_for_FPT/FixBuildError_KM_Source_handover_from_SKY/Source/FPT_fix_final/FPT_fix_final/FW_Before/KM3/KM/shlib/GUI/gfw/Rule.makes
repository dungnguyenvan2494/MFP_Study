######################################################
#Default configuration of makefile(For the simulator)
######################################################
GCC				= gcc
CC				= gcc
AS				= as
LD				= ld
MOC				= $(QTDIR)/bin/moc
GUILIB			= libgfw.so

DEPEND_INC		= .depend_$(BASETYPE).inc

######################################################
#Setting for hardware
######################################################
ifeq ($(TARGET), hw)
GCC				= $(CROSS_COMPILE)gcc
CC				= $(CROSS_COMPILE)gcc
AS				= $(CROSS_COMPILE)as
LD				= $(CROSS_COMPILE)ld
endif

INCLUDES	= \
				-I$(BASEPATH)/include \
				-I$(BASEPATH)/src \
				-I$(TOPPATH)/shlib/GUI/graphicdata \
				-I$(TOPPATH)/shlib/GUI/graphicdata/include \
				-I$(TOPPATH)/shlib/qtconnecter/includeApp \
				-I$(TOPPATH)/application/divlib/Common \
				-I$(TOPPATH)/application/divlib/Common/panel/pddtext \
				-I$(TOPPATH)/application \
				-I$(TOPPATH)/application/mfp/ \
				-I$(TOPPATH)/application/mfp/lib/sysdb \
				-I$(TOPPATH)/application/api/include

INCLUDES		+= -I$(QTDIR)/include/
INCLUDES		+= -I$(QTDIR)/include/QtCore/
INCLUDES		+= -I$(QTDIR)/include/QtGui/
ifeq ($(QTVERSION),q530)
INCLUDES		+= -I$(QTDIR)/include/QtWidgets/
INCLUDES		+= -I$(QTDIR)/include/QtKMOpenGLPainters/
else
INCLUDES		+= -I$(QTDIR)/include/Qt/
endif


ifeq ($(CROSS_COMPILE),mb86s72-linux-)
CFLAGS			= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all $(DBGFLG) $(INCLUDES) -fsigned-char
C++PARAMS		= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all $(DBGFLG) -fPIC -fsigned-char
C++INCS			= $(INCLUDES)
C++DEFS			= -DLINUX -D_FILE_OFFSET_BITS=64 -DFUM_LINUX
else
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
CFLAGS			= -mcpu=cortex-a7  -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -funwind-tables -Werror=all $(DBGFLG) $(INCLUDES) -fsigned-char
C++PARAMS		= -mcpu=cortex-a7  -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -funwind-tables -Werror=all $(DBGFLG) -fPIC -fsigned-char
C++INCS			= $(INCLUDES)
C++DEFS			= -DLINUX -D_FILE_OFFSET_BITS=64 -DFUM_LINUX
else
ifeq ($(CROSS_COMPILE),s800-linux-)
CFLAGS			= -mlittle-endian -funwind-tables -fno-aggressive-loop-optimizations -Werror=all -Wno-write-strings $(DBGFLG) $(INCLUDES) -fsigned-char
C++PARAMS		= -mlittle-endian -funwind-tables -fno-aggressive-loop-optimizations -Werror=all -Wno-write-strings $(DBGFLG) -fPIC -fsigned-char
C++INCS			= $(INCLUDES)
C++DEFS			= -DLINUX -D_FILE_OFFSET_BITS=64 -DFUM_LINUX
else
ifeq ($(CROSS_COMPILE),x86_64-linux-)
CFLAGS			= -Werror=all -Wno-write-strings $(DBGFLG) $(INCLUDES) -fsigned-char
C++PARAMS		= -Werror=all -Wno-write-strings $(DBGFLG) -fPIC -fsigned-char
C++INCS			= $(INCLUDES)
C++DEFS			= -DLINUX -D_FILE_OFFSET_BITS=64 -DFUM_LINUX
else
CFLAGS			= -Werror=all $(DBGFLG) $(INCLUDES) -fsigned-char
C++PARAMS		= -Werror=all -Werror $(DBGFLG) -fPIC -fsigned-char
C++INCS			= $(INCLUDES)
C++DEFS			= -DLINUX -D_FILE_OFFSET_BITS=64 -DFUM_LINUX
endif
endif
endif
endif

ifeq ($(BASETYPE),all)
#DBGFLG			=  -g -ggdb -O0
DBGFLG			=  -g -ggdb -O2
C++DEFS			+= -DSIMULATOR
else
DBGFLG			=  -g -ggdb -O2
endif

ifeq ($(IT4MACHINE_TYPE),Zeus)
C++DEFS			+= -DDEF_ZeusCus
endif
ifeq ($(IT4MACHINE_TYPE),MinervaEmu)
C++DEFS			+= -DDEF_MinervaEmu
endif
ifeq ($(IT4MACHINE_TYPE),ZeusEmu)
C++DEFS			+= -DDEF_ZeusEmu
endif
ifeq ($(IT4MACHINE_TYPE),DonauLinux)
C++DEFS			+= -DDEF_MinervaPreEmu
endif
ifeq ($(IT4MACHINE_TYPE),ZeusRevEmu)
C++DEFS			+= -DDEF_ZeusRevCus
endif
ifeq ($(IT4MACHINE_TYPE),SoCDonauEmu)
C++DEFS			+= -DDEF_MinervaEmu -DDEF_Soc1200
endif
ifeq ($(IT4MACHINE_TYPE),Zeus5BKPreEmu)
C++DEFS			+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_Zeus5BkCus
endif
ifeq ($(IT4MACHINE_TYPE),z5be2)
C++DEFS			+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HELIOS_EMU2 -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MonoCus -DDEF_Zeus5BkCus
endif
ifeq ($(IT4MACHINE_TYPE),z5be3)
C++DEFS			+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),z5b)
