###############################################################################
## GNU compilation tools definitions 
###############################################################################
## Defines

ifeq ($(USB20_INTERFACE), YES)
 TSS_DEFINES	   += -DINCLUDE_MIO_NCLI
 DRIVERS		   += ncLiEnd.o
endif

ifeq ($(IEEE1284_INTERFACE), YES)
 TSS_DEFINES	   += -DINCLUDE_MIO_PPLI
 DRIVERS		   += ppLiEnd.o
endif

ifeq ($(ROM_DIV), YES)
 TSS_DEFINES	   += -DROM_DIV
endif

ifeq ($(ROM_DIV_2), YES)
 TSS_DEFINES	   += -DROM_DIV_2
endif

ifeq ($(ROM_DIV_3), YES)
 TSS_DEFINES	   += -DROM_DIV_3
endif

#
# 機種別 コンパイルSW及びdependファイル設定
#
ifeq ($(IT4MACHINE_TYPE),Minerva)
 DEPEND_INC		= _minerva.depend
endif

ifeq ($(IT4MACHINE_TYPE),MinervaBK)
 TSS_DEFINES	   += -DDEF_MinervaBKCus -DDEF_MonoCus
 DEPEND_INC		= _minervabk.depend
endif

ifeq ($(IT4MACHINE_TYPE),Zeus)
 TSS_DEFINES	   += -DDEF_ZeusCus
 DEPEND_INC		= _zeus.depend
endif

ifeq ($(IT4MACHINE_TYPE),MinervaEmu)
 ifeq ($(MinervaArchiEmu),YES)
  TSS_DEFINES	   += -DDEF_MinervaArchiEmu
 endif
endif
ifeq ($(IT4MACHINE_TYPE),SoCZeus)
 ifeq ($(THRMACHINE_TYPE),ZeusS)
  TSS_DEFINES	+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Asic777_PMS
  ifeq ($(BUILD_CORE),amp0)
   DEPEND_INC = _ZeusS_amp0.depend
  else
   ifeq ($(BUILD_CORE),amp1)
    DEPEND_INC	= _ZeusS_amp1.depend
   else
    DEPEND_INC	= _ZeusS_single.depend
   endif
  endif
 else
  ifeq ($(THRMACHINE_TYPE),ZeusSA4)
   TSS_DEFINES	+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Asic777_PMS
   ifeq ($(BUILD_CORE),amp0)
    DEPEND_INC = _ZeusSA4_amp0.depend
   else
    ifeq ($(BUILD_CORE),amp1)
     DEPEND_INC	= _ZeusSA4_amp1.depend
    else
     DEPEND_INC	= _ZeusSA4_single.depend
    endif
   endif
  else
   ifeq ($(THRMACHINE_TYPE),VenusMLK)
    TSS_DEFINES	+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Asic777_PMS
    ifeq ($(BUILD_CORE),amp0)
     DEPEND_INC = _VenusMLK_amp0.depend
    else
     ifeq ($(BUILD_CORE),amp1)
      DEPEND_INC	= _VenusMLK_amp1.depend
     else
      DEPEND_INC	= _VenusMLK_single.depend
     endif
    endif
   else
    TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard
    ifeq ($(BUILD_CORE),amp0)
     DEPEND_INC		= _SoCZeus_amp0.depend
    else
     ifeq ($(BUILD_CORE),amp1)
      DEPEND_INC		= _SoCZeus_amp1.depend
     else
      DEPEND_INC		= _SoCZeus_single.depend
     endif
    endif
   endif
  endif
 endif
endif

