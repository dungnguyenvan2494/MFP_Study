CC_WARNING		= -Werror=all -Wno-unused-but-set-variable -Wno-char-subscripts -Wno-error=sign-compare -Wno-error=conversion-null -Wno-error=narrowing
CC_WARNING		+= -Wno-write-strings  -Wno-strict-aliasing -Wconversion -Werror=pointer-to-int-cast -Werror=int-to-pointer-cast -Werror=overflow
CC_WARNING		+= -fpermissive -Wno-error=misleading-indentation -Wno-error=parentheses -Wno-error=nonnull-compare -Wno-error=nonnull -Wno-error=address -Wno-error=restrict -Wno-error=address -Wno-error=catch-value -Wno-error=unused-const-variable -Wno-error=register -Wno-error=sizeof-array-div -Wno-error=return-type -Wno-error=maybe-uninitialized -Wno-error=tautological-compare -Wno-error=int-in-bool-context -Wno-error=sizeof-pointer-div
C++_WARNING		= -Werror=all -Wno-unused-but-set-variable -Wno-char-subscripts -Wno-error=sign-compare -Wno-error=conversion-null -Wno-error=narrowing
C++_WARNING		+= -Wno-write-strings  -Wno-strict-aliasing -Wconversion -Werror=pointer-to-int-cast -Werror=int-to-pointer-cast -Werror=overflow
C++_WARNING		+= -fpermissive -Wno-error=misleading-indentation -Wno-error=parentheses -Wno-error=nonnull-compare -Wno-error=nonnull -Wno-error=address -Wno-error=restrict -Wno-error=address -Wno-error=catch-value -Wno-error=unused-const-variable -Wno-error=register -Wno-error=sizeof-array-div -Wno-error=return-type -Wno-error=maybe-uninitialized -Wno-error=tautological-compare -Wno-error=int-in-bool-context -Wno-error=sizeof-pointer-div


ifeq ($(CROSS_COMPILE),mv78460-linux-)
 #2013/01/22 MV78460暫定対応
 #MV78460暫定対応用のフラグ作成(ソースコード用)
 CC_MV78460_TEMP = -DMV78460_TEMPORARY

 #アーキテクチャがARMの場合に使用
 CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
endif

ifeq ($(CROSS_COMPILE),mb86s73-linux-)
 #暫定対応用のフラグ作成(ソースコード用)
 CC_MV78460_TEMP = -DMV78460_TEMPORARY

 #アーキテクチャがARMの場合に使用
 CC_ARCH_COMPILE_SW	= -DCASE_OF_ARM
endif

ifeq ($(CROSS_COMPILE),mb86s72-linux-)
 #暫定対応用のフラグ作成(ソースコード用)
 CC_MV78460_TEMP = -DMV78460_TEMPORARY

 #アーキテクチャがARMの場合に使用
