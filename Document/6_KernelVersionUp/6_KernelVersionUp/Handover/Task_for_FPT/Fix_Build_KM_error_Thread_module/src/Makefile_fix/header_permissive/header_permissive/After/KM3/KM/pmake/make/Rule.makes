# Moved 2017.10.16
# OPENSSL include path NICFUM7.6
# [NICFUM7.6][FVT] Confirm whether openssl library replacement correspondence is required.
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
 CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/openssl/include/s72_s73/openssl-1.0.2l-include
endif
ifeq ($(CROSS_COMPILE),mb86s72-linux-)
 CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/openssl/include/s72_s73/openssl-1.0.2l-include
endif
ifeq ($(CROSS_COMPILE),s800-linux-)
 # MOD 2019.10.30 NICFUM TLS1.3対応
 CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/openssl/include/a64_mv7040/openssl-1.1.1-include
endif
ifeq ($(CROSS_COMPILE),i386-linux-)
 CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/openssl/include/simulator/openssl-1.0.2l-include
endif
ifeq ($(CROSS_COMPILE),x86_64-linux-)
 # MOD 2019.10.30 NICFUM TLS1.3対応
 CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/openssl/include/sim64/openssl-1.1.1-include
endif

# LibP11 include path NICFUM7.6
 # MOD 2019.10.30 NICFUM TLS1.3対応
CC_INCLUDE += -I$(TOPPATH)/application/mfp/lib/libp11/include/libp11-0.4.10-include

#ifeq ($(GCC_VER_KM),5.2.1)
ifeq ($(GCC_VER_KM),11.4.0)	
	ifeq ($(CROSS_COMPILE),s800-linux-)
		CC_INCLUDE	+=  \
						-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include/c++/5.2.1 \
						-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include/c++/5.2.1/aarch64-linux-gnu \
						-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/libc/usr/include \
						-I/opt/marvell/s800/toolchain/lib/gcc/aarch64-linux-gnu/5.2.1/include \
						-I/opt/marvell/s800/toolchain/lib/gcc/aarch64-linux-gnu/5.2.1/include-fixed \
						-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include
	endif
endif
ifeq ($(GCC_VER_KM),4.6.4)
ifeq ($(CROSS_COMPILE),mv78460-linux-)
ifeq ($(MV78460_MAKE_TEMP),YES)
CC_INCLUDE	+=	-I/opt/marvell/mv78460/toolchain/arm-marvell-linux-gnueabi/include/c++/4.6.4 \
				-I/opt/marvell/mv78460/toolchain/arm-marvell-linux-gnueabi/include/c++/4.6.4/arm-marvell-linux-gnueabi \
				-I/opt/marvell/mv78460/toolchain/arm-marvell-linux-gnueabi/include/c++/4.6.4/backward \
				-I/opt/marvell/mv78460/toolchain/arm-marvell-linux-gnueabi/libc/usr/include \
				-I/opt/marvell/mv78460/toolchain/lib/gcc/arm-marvell-linux-gnueabi/4.6.4/include \
				-I/opt/marvell/mv78460/toolchain/lib/gcc/arm-marvell-linux-gnueabi/4.6.4/include-fixed \
				-I/opt/marvell/mv78460/toolchain/include \
