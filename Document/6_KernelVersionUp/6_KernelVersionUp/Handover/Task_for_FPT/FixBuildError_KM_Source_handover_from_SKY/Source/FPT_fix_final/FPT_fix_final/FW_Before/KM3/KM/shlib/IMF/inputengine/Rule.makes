######################################################
#Default configuration of makefile(For the simulator)
######################################################
GCC				= gcc
CC				= gcc
AS				= as
LD				= ld
MOC				= $(QTDIR)/bin/moc
INPLIB			= libinputengine.so


######################################################
#Setting for hardware
######################################################
ifeq ($(TARGET), hw)
GCC				= $(CROSS_COMPILE)gcc
CC				= $(CROSS_COMPILE)gcc
AS				= $(CROSS_COMPILE)as
LD				= $(CROSS_COMPILE)ld
endif

INCLUDES	= \
			-I$(BASEPATH)/include \
			-I$(TOPPATH)/application/mfp/ \
			-I$(TOPPATH)/application/divlib/Common/

ifeq ($(BASETYPE),all)
DBGFLG	=  -g -ggdb -O0
else
DBGFLG	=  -g -ggdb -O2
endif

ifeq ($(CROSS_COMPILE),mb86s72-linux-)
CFLAGS		+= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all $(DBGFLG) $(INCLUDES) -fsigned-char
# 外部ライブラリ(CChg.cppとkconv.cpp)のビルドでエラーとなるため、Werrorオプションは取り除いている.
#C++FLAGS	+= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all -Werror $(DBGFLG) -fpic $(INCLUDES) -DLINUX -D_FILE_OFFSET_BITS=64 -fsigned-char
C++FLAGS	+= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -Werror=all $(DBGFLG) -fpic $(INCLUDES) -DLINUX -D_FILE_OFFSET_BITS=64 -fsigned-char

else
CFLAGS		= -Werror=all $(DBGFLG) $(INCLUDES) -fsigned-char
# 外部ライブラリ(CChg.cppとkconv.cpp)のビルドでエラーとなるため、Werrorオプションは取り除いている.
#C++FLAGS	= -Werror=all $(DBGFLG) -fpic $(INCLUDES) -DLINUX -D_FILE_OFFSET_BITS=64 -fsigned-char
C++FLAGS	= -Werror=all $(DBGFLG) -fpic $(INCLUDES) -DLINUX -D_FILE_OFFSET_BITS=64 -fsigned-char
endif

ifeq ($(ADDRESS_SANITIZER),YES)
CFLAGS		+= -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
C++FLAGS	+= -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

ifeq ($(IT4MACHINE_TYPE),Zeus)
C++FLAGS	+= -DDEF_ZeusCus
endif
ifeq ($(IT4MACHINE_TYPE),z5be2)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HELIOS_EMU2 -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MonoCus -DDEF_Zeus5BkCus
endif
ifeq ($(IT4MACHINE_TYPE),z5be3)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),z5b)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),zse3)
ifeq ($(MACHINE_CAPACITY),a4)
C++FLAGS		+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
else
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_ZEUSS_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
endif
ifeq ($(IT4MACHINE_TYPE),zse3_a4)
C++FLAGS		+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),vmlk)
C++FLAGS		+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),vmlke)
C++FLAGS		+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_A4_Cus_EMU_A3
endif
ifeq ($(IT4MACHINE_TYPE),vmlkeve)
C++FLAGS		+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_A4_Cus_EMU_Venus
endif
ifeq ($(IT4MACHINE_TYPE),zs)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_ZEUSS_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),zsb)
C++FLAGS		+= -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK12_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),zsbx)
C++FLAGS		+= -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBKX0_CUS -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),zsbe)
C++FLAGS		+= -DDEF_MonoCus -DDEF_ZeusBKCus -DDEF_ZEUSSBK12_CUS -DDEF_ZEUSS_BASE_EMU -DDEF_ZeusCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),ZeusSPreEmu)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_ZEUSS_CUS
endif
ifeq ($(IT4MACHINE_TYPE),he3)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_HeliosCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),he)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HeliosCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),ic)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HeliosCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ICARUS_CUS
endif
ifeq ($(IT4MACHINE_TYPE),ice)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HeliosCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_ICARUS_CUS -DDEF_HELIOS_BASE_EMU
endif
ifeq ($(IT4MACHINE_TYPE),HeliosLPreEmu)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_HeliosCus
endif
ifeq ($(IT4MACHINE_TYPE),msbe3)
C++FLAGS		+= -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_MINERVASBK_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),MinervaSBKPreEmu)
C++FLAGS	+= -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_MINERVASBK_CUS
endif
ifeq ($(IT4MACHINE_TYPE),msb)
C++FLAGS		+= -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_MINERVASBK_CUS -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
endif
ifeq ($(IT4MACHINE_TYPE),MinervaEmu)
C++FLAGS	+= -DDEF_MinervaEmu
endif
ifeq ($(IT4MACHINE_TYPE),ZeusEmu)
C++FLAGS	+= -DDEF_ZeusEmu
endif
ifeq ($(IT4MACHINE_TYPE),DonauLinux)
C++FLAGS	+= -DDEF_MinervaPreEmu
endif
ifeq ($(IT4MACHINE_TYPE),ZeusRevEmu)
C++FLAGS	+= -DDEF_ZeusRevCus
endif
ifeq ($(IT4MACHINE_TYPE),SoCDonauEmu)
C++FLAGS	+= -DDEF_MinervaEmu -DDEF_Soc1200
endif
ifeq ($(IT4MACHINE_TYPE),SoCZeusEmu2ndAmur)
C++FLAGS	+= -DDEF_ZeusEmu -DDEF_ZeusMLKEmu -DDEF_Soc1200 -DDEF_ZeusMLKBoard
endif
ifeq ($(IT4MACHINE_TYPE),SoCZeusEmu2ndZeus)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusMLKEmu -DDEF_Soc1200 -DDEF_ZeusMLKBoard
endif
ifeq ($(IT4MACHINE_TYPE),ZeusBKPreEmu)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusBKEmu -DDEF_MonoCus
endif
ifeq ($(IT4MACHINE_TYPE),SoCZeusBKEmu)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusMLKEmu -DDEF_ZeusBKEmu -DDEF_Soc1200 -DDEF_MonoCus -DDEF_ZeusMLKBoard
endif
ifeq ($(IT4MACHINE_TYPE),SoCZeusBK)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_MonoCus -DDEF_ZeusMLKBoard
endif
ifeq ($(IT4MACHINE_TYPE),Zeus5BKPreEmu)
C++FLAGS	+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_Zeus5BkCus
endif
ifeq ($(IT4MACHINE_TYPE),mse73)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_ZEUSS_CUS  -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MinervaS_PF -DDEF_MINERVAS_CUS
endif
ifeq ($(IT4MACHINE_TYPE),msbe73)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusBKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_Zeus5BkCus -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MinervaS_PF -DDEF_MINERVASBK_CUS
endif
ifeq ($(IT4MACHINE_TYPE),mse72)
C++FLAGS		+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_ZEUSS_CUS  -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MinervaS_PF -DDEF_MINERVAS_CUS
endif
ifeq ($(IT4MACHINE_TYPE),msbe72)
C++FLAGS		+= -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_MonoCus -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_MinervaS_PF -DDEF_MINERVASBK_CUS
endif
ifeq ($(IT4MACHINE_TYPE),ZeusS_ZX0PreEmu)
C++FLAGS		+= -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard
endif
ifeq ($(IT4MACHINE_TYPE),zsze3)
C++FLAGS		+= -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_SharedMemMCPF_IF -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS -DDEF_LITTLEENDIAN
endif
ifeq ($(IT4MACHINE_TYPE),zsze72)
C++FLAGS		+= -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_SharedMemMCPF_IF -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS -DDEF_LITTLEENDIAN
endif
ifeq ($(IT4MACHINE_TYPE),zsz)
C++FLAGS		+= -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_ZEUSS_ZX0_CUS -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_SharedMemMCPF_IF -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS -DDEF_LITTLEENDIAN
endif
ifeq ($(IT4MACHINE_TYPE),mmlke72)
C++FLAGS		+= -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_MINERVAMLK_CUS -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_SharedMemMCPF_IF -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS -DDEF_LITTLEENDIAN
endif
ifeq ($(IT4MACHINE_TYPE),mmlk)
C++FLAGS		+= -DDEF_Helios_PF -DDEF_MinervaS_PF -DDEF_MINERVAMLK_CUS -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_SharedMemMCPF_IF -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT -DDEF_Asic777_PMS -DDEF_LITTLEENDIAN
endif
C++FLAGS	+= -DDEF_MoselBoard
C++FLAGS	+= -DDEF_MoselCom
C++FLAGS	+= -DDEF_PANELDRV
C++FLAGS	+= -DDEF_THAMES_I
C++FLAGS	+= -DLINUX
C++FLAGS	+= -DQT_PANEL
C++FLAGS	+= -DTORNADO
C++FLAGS	+= -DTORV22

C++FLAGS	+= -DSIMULATOR
C++FLAGS	+= -DFUM_LINUX

ifeq ($(LCDTYPE),7inch)
C++FLAGS	+= -DDEF_LCD_7INCH
endif

ifeq ($(RESTYPE),WQVGA)
C++FLAGS	+= -DDEF_RES_WQVGA
else
ifeq ($(RESTYPE),WSVGA)
# 2019/02/19 OP_BTS-2076 LocalUI東島 IT6機種では3ペイン表示のためWVGAで画面表示制御を行っている.
# そのためmmlk(IT5機種)を除きIT6機種ではDEF_RES_WSVGAを定義しないように対応.
 ifeq ($(IT4MACHINE_TYPE),mmlk)
  C++FLAGS	+= -DDEF_RES_WSVGA
 endif
else
ifeq ($(RESTYPE),FullHD)
C++FLAGS	+= -DDEF_RES_FHD
else
ifeq ($(RESTYPE),WXGA)
C++FLAGS	+= -DDEF_RES_WXGA
endif
endif
endif
endif


LDFLAGS		= -Wl,--relax -lstdc++ -lpthread -lrt -lgcc_s
ifeq ($(QTVERSION),q530)
LIBS		= -L$(QTDIR)/lib -lQt5Core -lQt5Gui -lQt5Network
else
LIBS		= -L$(QTDIR)/lib -lQtCore -lQtGui -lQtNetwork
endif

