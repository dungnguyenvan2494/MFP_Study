ifeq ($(BASETYPE),all)
 CFLAGS        = $(CC_ARCH_SPEC) $(CC_ARCH_DEFS) $(CC_INCLUDE) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(CC_WARNING) $(TSS_DEFINES) -funwind-tables -fPIC -fPIE
C++PARAMS		= $(CC_ARCH_SPEC) $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope -fPIC -fPIE
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 CFLAGS_AS     = $(CC_ARCH_SPEC) $(CC_ARCH_DEFS) $(CC_INCLUDE) $(CC_OPTIM_TARGET) $(TSS_DEFINES) -P -x assembler-with-cpp -fPIC -fPIE
else
 CFLAGS        = $(CC_ARCH_SPEC) $(CC_ARCH_DEFS) $(CC_INCLUDE) -nostdinc -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(CC_OPTIM_TARGET) $(CC_WARNING) $(TSS_DEFINES)
 ifeq ($(CROSS_COMPILE),mv78460-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mb86s73-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mb86s72-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
 ifeq ($(CROSS_COMPILE),mv62x0-linux-)
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 else
C++PARAMS		= $(CC_ARCH_SPEC) -nostdinc $(CC_OPTIM_TARGET) $(C++_WARNING) -fno-for-scope
C++INCS			= $(CC_INCLUDE)
C++DEFS			= $(CC_ARCH_DEFS) -DTORV22 -D_REENTRANT -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 $(TSS_DEFINES)
 endif
 endif
 endif
 endif
 CFLAGS_AS     = $(CC_ARCH_SPEC) $(CC_INCLUDE) -nostdinc $(CC_OPTIM_TARGET) $(TSS_DEFINES) -P -x assembler-with-cpp
endif

