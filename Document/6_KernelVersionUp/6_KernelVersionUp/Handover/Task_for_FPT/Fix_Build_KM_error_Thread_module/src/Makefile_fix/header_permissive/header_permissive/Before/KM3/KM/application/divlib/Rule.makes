				-I/opt/timesys/toolchains/powerpc-timesys-linux-gnu/include/c++/4.2.1/powerpc-timesys-linux-gnu/74xx \
				-I/opt/timesys/toolchains/powerpc-timesys-linux-gnu/include/c++/4.2.1/backward \
				-I/opt/timesys/toolchains/ppc74xx-linux/powerpc-timesys-linux-gnu/include
else
ifeq ($(GCC_VER_KM),3.4)
CC_INCLUDE	+=  -nostdinc \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/lib/gcc/powerpc-linux/3.4/include \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/ \
