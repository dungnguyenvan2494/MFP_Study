###############################################################################
## Include Directries 
CC_INCLUDE	+=	-I. \

CC_INCLUDE	+=	-I$(COMMONPATH)/../api/include \

CC_INCLUDE	+=	-I$(COMMONPATH)/../../shlib/GUI/gfw/include
CC_INCLUDE	+=	-I$(COMMONPATH)/../../shlib/GUI/graphicdata

## BlackAPI@Proxy-Stub 2011.08.03 tri ishida ->
CC_INCLUDE	+=	-I$(COMMONPATH)/panel/plibl/FT/include \
## BlackAPI@Proxy-Stub 2011.08.03 tri ishida <-

# hosono reduction of ui sourcecodes.
CC_INCLUDE  += -I$(COMMONPATH)/../divlib/Common

ifeq ($(BASETYPE),hw)
ifeq ($(GCC_VER_KM),5.2.1)
ifeq ($(CROSS_COMPILE),s800-linux-)
CC_INCLUDE	+=  \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include/c++/5.2.1 \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include/c++/5.2.1/aarch64-linux-gnu \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include/c++/5.2.1/backward \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/libc/usr/include \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/5.2.1/include \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/5.2.1/include-fixed \
			-I/opt/marvell/s800/toolchain/aarch64-linux-gnu/include
endif
endif
ifeq ($(GCC_VER_KM),4.3.3)
ifeq ($(CROSS_COMPILE),mpc8536-linux-)
CC_INCLUDE	+=	-nostdinc \
			-I/opt/timesys/mpc8536a_dk/toolchain/powerpc-timesys-linux-gnuspe/include/c++/4.3.3 \
			-I/opt/timesys/mpc8536a_dk/toolchain/powerpc-timesys-linux-gnuspe/include/c++/4.3.3/powerpc-timesys-linux-gnuspe \
