			-I/opt/timesys/amcc440epx/toolchain/include/linux 
endif
endif
endif
else
ifeq ($(GCC_VER_KM),4.2.1)
CC_INCLUDE	+=  -nostdinc \
				-I/opt/timesys/toolchains/lib/gcc/powerpc-timesys-linux-gnu/4.2.1/include \
				-I/opt/timesys/toolchains/lib/gcc/powerpc-timesys-linux-gnu/4.2.1/include-fixed \
				-I/opt/timesys/toolchains/powerpc-timesys-linux-gnu/libc/usr/include \
