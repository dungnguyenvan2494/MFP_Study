endif
ifeq ($(IT4MACHINE_TYPE),zse3)
ifeq ($(MACHINE_CAPACITY),a4)
C++DEFS			+= -DDEF_A4_Cus -DDEF_A3A4COMM -DDEF_A3A4ENGSTUB -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
else
C++DEFS			+= -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_IT5EMU3 -DDEF_ZEUSS_CUS -DDEF_Helios_PF -DDEF_SharedMemMCPF_IF -DDEF_LITTLEENDIAN -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
