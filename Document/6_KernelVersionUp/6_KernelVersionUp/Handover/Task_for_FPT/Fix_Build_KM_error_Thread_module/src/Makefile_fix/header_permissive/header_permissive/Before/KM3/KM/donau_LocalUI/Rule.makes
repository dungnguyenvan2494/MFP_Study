				-I/opt/timesys/toolchains/powerpc-timesys-linux-gnu/include/c++/4.2.1/backward \
				-I/opt/timesys/toolchains/ppc74xx-linux/powerpc-timesys-linux-gnu/include
else
ifeq ($(GCC_VER_KM),3.4)
CC_INCLUDE	+=  -I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/lib/gcc/powerpc-linux/3.4/include \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/ \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/linux \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/c++/3.4 \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/c++/3.4/powerpc-linux \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/c++/3.4/backward \
				-I/opt/timesys/linux/5.0/toolchains/ppc74xx-linux/include/asm
else
# Error !!
endif

endif
endif

