			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/include \
			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/include-fixed \
			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/../../../../armv7l-timesys-linux-gnueabihf/include \
			-I/opt/km/6270/toolchain/bin/../../toolchain/usr/include \
			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/../../../../armv7l-timesys-linux-gnueabihf/include/c++/4.9.3 \
			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/../../../../armv7l-timesys-linux-gnueabihf/include/c++/4.9.3/armv7l-timesys-linux-gnueabihf \
			-I/opt/km/6270/toolchain/bin/../lib/gcc/armv7l-timesys-linux-gnueabihf/4.9.3/../../../../armv7l-timesys-linux-gnueabihf/include/c++/4.9.3/backward
endif
else
# Error !!
