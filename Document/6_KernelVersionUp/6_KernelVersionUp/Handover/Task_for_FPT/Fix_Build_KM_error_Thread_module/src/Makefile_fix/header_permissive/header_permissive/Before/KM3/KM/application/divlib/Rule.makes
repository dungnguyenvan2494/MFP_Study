			-I/opt/linaro/linaro473_20130221/toolchain/lib/gcc/arm-linux-gnueabihf/4.7.3/include \
			-I/opt/linaro/linaro473_20130221/toolchain/lib/gcc/arm-linux-gnueabihf/4.7.3/include-fixed
endif
else

ifeq ($(GCC_VER_KM),4.8.3)
