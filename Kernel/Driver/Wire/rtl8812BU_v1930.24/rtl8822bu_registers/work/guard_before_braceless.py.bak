"""Runtime chip/interface guard evaluation for shared driver code.

Shared files (phydm, halmac_88xx, hal_com...) select per-chip code at run time,
e.g. `if (dm->support_ic_type & ODM_RTL8822B)`. The #if mask cannot see this.
This module evaluates such conditions assuming the running device is an
RTL8822B on USB, with 3-valued logic: True / False / None (unknown).

Runtime facts substituted (all from this build's own code paths):
  <x>->support_ic_type   -> ODM_RTL8822B         (phydm IC type)
  <x>->support_interface -> ODM_ITRF_USB
  <x>->chip_id           -> HALMAC_CHIP_ID_8822B (halmac adapter)
  <x>->intf              -> HALMAC_INTERFACE_USB
  rtw_get_hw_type(..)    -> HARDWARE_TYPE_RTL8822BU
  GET_CVID_IC_TYPE(..)   -> CHIP_8822B
  rtw_get_intf_type(..)  -> RTW_USB
Everything else that is not a resolvable constant is Unknown.
"""
import ast, re

ID = re.compile(r'\b[A-Za-z_]\w*\b')

RUNTIME = [
    (re.compile(r'[\w\]\)]+(?:\s*(?:->|\.)\s*\w+)*\s*(?:->|\.)\s*support_ic_type\b'), 'ODM_RTL8822B'),
    (re.compile(r'[\w\]\)]+(?:\s*(?:->|\.)\s*\w+)*\s*(?:->|\.)\s*support_interface\b'), 'ODM_ITRF_USB'),
    (re.compile(r'[\w\]\)]+(?:\s*(?:->|\.)\s*\w+)*\s*(?:->|\.)\s*chip_id\b'), 'HALMAC_CHIP_ID_8822B'),
    (re.compile(r'[\w\]\)]+(?:\s*(?:->|\.)\s*\w+)*\s*(?:->|\.)\s*intf\b'), 'HALMAC_INTERFACE_USB'),
    (re.compile(r'\brtw_get_hw_type\s*\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)'), 'HARDWARE_TYPE_RTL8822BU'),
    (re.compile(r'\bGET_CVID_IC_TYPE\s*\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)'), 'CHIP_8822B'),
    (re.compile(r'\brtw_get_intf_type\s*\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)'), 'RTW_USB'),
]
CHIP_TOKENS = re.compile(r'ODM_RTL\w+|ODM_IC_\w+|HALMAC_CHIP_ID_\w+|IS_HARDWARE_TYPE_\w+|IS_\w+_SERIES|'
                         r'HARDWARE_TYPE_\w+|CHIP_8\w+|ODM_ITRF_\w+|HALMAC_INTERFACE_\w+|RTW_(USB|PCIE|SDIO)\b')


class _U:
    """Unknown value: every operation yields Unknown."""
    def _u(self, *a, **k): return U
    __add__ = __radd__ = __sub__ = __rsub__ = __mul__ = __rmul__ = _u
    __and__ = __rand__ = __or__ = __ror__ = __xor__ = __rxor__ = _u
    __lshift__ = __rlshift__ = __rshift__ = __rrshift__ = __invert__ = __neg__ = _u
    __floordiv__ = __rfloordiv__ = __mod__ = __rmod__ = __truediv__ = __rtruediv__ = _u
    __eq__ = __ne__ = __lt__ = __le__ = __gt__ = __ge__ = _u
    __call__ = __getitem__ = _u
    def __getattr__(self, n): return U
    def __hash__(self): return 0
U = _U()


def AND(*xs):
    unk = False
    for x in xs:
        x = x() if callable(x) and not isinstance(x, _U) else x
        if isinstance(x, _U): unk = True
        elif not x: return False
    return None if unk else True

def OR(*xs):
    unk = False
    for x in xs:
        x = x() if callable(x) and not isinstance(x, _U) else x
        if isinstance(x, _U): unk = True
        elif x: return True
    return None if unk else False

def NOT(x):
    return U if isinstance(x, _U) else (not x)

def TERN(c, a, b):
    if isinstance(c, _U): return U
    return a if c else b

def _tv(x):
    """Convert evaluation result to True/False/None."""
    if x is None or isinstance(x, _U): return None
    return bool(x)


class _Tx(ast.NodeTransformer):
    def visit_BoolOp(self, n):
        self.generic_visit(n)
        f = 'AND' if isinstance(n.op, ast.And) else 'OR'
        lam = [ast.Lambda(args=ast.arguments(posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[]),
                          body=_wrap(v)) for v in n.values]
        return ast.Call(func=ast.Name(f, ast.Load()), args=lam, keywords=[])
    def visit_UnaryOp(self, n):
        self.generic_visit(n)
        if isinstance(n.op, ast.Not):
            return ast.Call(func=ast.Name('NOT', ast.Load()), args=[n.operand], keywords=[])
        return n
    def visit_IfExp(self, n):
        self.generic_visit(n)
        return ast.Call(func=ast.Name('TERN', ast.Load()), args=[n.test, n.body, n.orelse], keywords=[])

def _wrap(v):
    # make sub-results 3-valued-friendly: AND/OR receive raw values
    return v


class Guard:
    def __init__(self, defs, enums, resolve):
        self.defs, self.enums, self.resolve = defs, enums, resolve
        self.cache = {}

    def texpand(self, s, depth=0):
        """Textual macro expansion; unknown identifiers stay as they are."""
        if depth > 12:
            return s
        out, pos, changed = [], 0, False
        for m in ID.finditer(s):
            if m.start() < pos:
                continue
            out.append(s[pos:m.start()])
            name = m.group(0); pos = m.end()
            d = self.defs.get(name)
            if not d:
                out.append(name); continue
            f, l, p, body = d[0]
            if p is None:
                out.append('(' + body + ')'); changed = True
            else:
                args, end = _call_args(s, pos)
                if args is None or len(args) != len(p):
                    out.append(name); continue
                b = body
                for pn, av in zip(p, args):
                    b = re.sub(r'\b%s\b' % re.escape(pn), '(' + av + ')', b)
                out.append('(' + b + ')'); pos = end; changed = True
        out.append(s[pos:])
        r = ''.join(out)
        return self.texpand(r, depth + 1) if changed else r

    def eval(self, cond):
        """Evaluate a C condition for RTL8822BU. Returns (verdict, chip_related)."""
        if cond in self.cache:
            return self.cache[cond]
        s = self.texpand(cond)
        chip = bool(CHIP_TOKENS.search(s))
        s = sub_member(s, 'HardwareType', 'HARDWARE_TYPE_RTL8822BU')
        for f, rep in (('support_ic_type', 'ODM_RTL8822B'), ('support_interface', 'ODM_ITRF_USB'),
                       ('chip_id', 'HALMAC_CHIP_ID_8822B'), ('intf', 'HALMAC_INTERFACE_USB')):
            s = sub_member(s, f, rep)
        for rx, rep in RUNTIME:
            s = rx.sub(rep, s)
        # halmac idiom: `enum halmac_interface intf = adapter->intf;` then `if (intf == HALMAC_INTERFACE_x)`
        if 'HALMAC_INTERFACE_' in s:
            s = re.sub(r'(?<![\w>.])intf\b', 'HALMAC_INTERFACE_USB', s)
        res = None
        if chip:
            res = self._eval_c(s)
        self.cache[cond] = (res, chip)
        return res, chip

    CFG_TOKENS = re.compile(r'fw_offload_ability|mp_mode|bmp_mode|mppriv\.mode|registrypriv\.mp_mode')

    def eval_cfg(self, cond):
        """Evaluate a condition under the default runtime configuration:
        fw_offload_ability = PHYDM_RF_IQK_OFFLOAD only (rtw_iqk_fw_offload=1,
        CONFIG_FW_OFFLOAD_PARAM_INIT off), MP mode off. Returns (verdict, cfg_related)."""
        key = ('cfg', cond)
        if key in self.cache:
            return self.cache[key]
        s = self.texpand(cond)
        rel = bool(self.CFG_TOKENS.search(s))
        res = None
        if rel:
            s = sub_member(s, 'fw_offload_ability', 'PHYDM_RF_IQK_OFFLOAD')
            s = re.sub(r'\*\s*\(?\s*\w+\s*(?:->|\.)\s*mp_mode\s*\)?', '0', s)
            for f in ('mp_mode', 'bmp_mode'):
                s = sub_member(s, f, '0')
            s = sub_member(s, 'mode', '0') if 'mppriv' in s else s
            for rx, rep in RUNTIME:
                s = rx.sub(rep, s)
            res = self._eval_c(s)
        self.cache[key] = (res, rel)
        return res, rel

    def _eval_c(self, s):
        s = re.sub(r'\(\s*(?:u8|u16|u32|u64|s8|s16|s32|int|unsigned int|bool|boolean|enum \w+)\s*\)', '', s)
        s = re.sub(r'\b(0[xX][0-9a-fA-F]+|\d+)[uUlL]+\b', r'\1', s)
        s = s.replace('->', '.')
        s = s.replace('&&', ' and ').replace('||', ' or ')
        s = re.sub(r'!(?!=)', ' not ', s)
        s = re.sub(r'\btrue\b|\b_TRUE\b|\bTRUE\b', '1', s)
        s = re.sub(r'\bfalse\b|\b_FALSE\b|\bFALSE\b', '0', s)
        # C ternary a ? b : c  ->  skip (rare in guards)
        if '?' in s:
            return None
        env = {'AND': AND, 'OR': OR, 'NOT': NOT, 'TERN': TERN}
        names = set(ID.findall(s)) - {'and', 'or', 'not', 'AND', 'OR', 'NOT'}
        for n in names:
            v = self.enums.get(n)
            if v is None:
                v = self.resolve(n)
            env[n] = v if v is not None else U
        try:
            tree = ast.parse(s.strip(), mode='eval')
            tree = ast.fix_missing_locations(_Tx().visit(tree))
            env['__builtins__'] = {}
            r = eval(compile(tree, '<g>', 'eval'), env)
        except Exception:
            return None
        return _tv(r)


def sub_member(s, field, rep):
    """Replace every member-access chain ending in `->field` / `.field`
    (primary may be an identifier or a balanced parenthesised expression)."""
    rx = re.compile(r'(?:->|\.)\s*%s\b' % field)
    while True:
        m = rx.search(s)
        if not m:
            return s
        i = m.start()
        # walk back over the chain: identifiers, ->, ., [..], (..)
        while i > 0:
            j = i
            while j > 0 and s[j - 1].isspace(): j -= 1
            if j >= 2 and s[j - 2:j] == '->':
                i = j - 2; continue
            if j >= 1 and s[j - 1] == '.':
                i = j - 1; continue
            if j >= 1 and (s[j - 1].isalnum() or s[j - 1] == '_'):
                k = j
                while k > 0 and (s[k - 1].isalnum() or s[k - 1] == '_'): k -= 1
                i = k
                # a cast `(T)x` or call `f(x)` stays outside; stop after primary id
                kk = k
                while kk > 0 and s[kk - 1].isspace(): kk -= 1
                if kk >= 2 and s[kk - 2:kk] == '->' or kk >= 1 and s[kk - 1] == '.':
                    continue
                break
            if j >= 1 and s[j - 1] in ')]':
                close, open_ = s[j - 1], '(' if s[j - 1] == ')' else '['
                d, k = 0, j - 1
                while k >= 0:
                    if s[k] == close: d += 1
                    elif s[k] == open_:
                        d -= 1
                        if d == 0: break
                    k -= 1
                i = max(k, 0)
                kk = i
                while kk > 0 and s[kk - 1].isspace(): kk -= 1
                if kk >= 2 and s[kk - 2:kk] == '->' or kk >= 1 and s[kk - 1] in '.)]' or \
                   kk >= 1 and (s[kk - 1].isalnum() or s[kk - 1] == '_'):
                    continue
                break
            break
        s = s[:i] + rep + s[m.end():]


def _call_args(s, pos):
    i = pos
    while i < len(s) and s[i].isspace(): i += 1
    if i >= len(s) or s[i] != '(':
        return None, pos
    lvl, j, start, args = 0, i, i + 1, []
    while j < len(s):
        c = s[j]
        if c == '(':
            lvl += 1
        elif c == ')':
            lvl -= 1
            if lvl == 0:
                args.append(s[start:j].strip()); return args, j + 1
        elif c == ',' and lvl == 1:
            args.append(s[start:j].strip()); start = j + 1
        j += 1
    return None, pos


# ---------------------------------------------------------------- block structure
HDR_IF = re.compile(r'^\s*(else\s+)?if\s*\((.*)\)\s*$', re.S)
HDR_ELSE = re.compile(r'^\s*else\s*$')
HDR_SWITCH = re.compile(r'^\s*switch\s*\((.*)\)\s*$', re.S)

def blocks_of(text):
    """Return list of blocks [open, close, header, prev_sibling_index]."""
    blocks, stack, last_closed = [], [], {}
    hdr_start = 0
    depth = 0
    for i, c in enumerate(text):
        if c == '{':
            hdr = text[hdr_start:i]
            prev = last_closed.get(depth)
            stack.append(len(blocks))
            blocks.append([i, None, ' '.join(hdr.split()), prev, depth])
            depth += 1
            hdr_start = i + 1
        elif c == '}':
            if stack:
                b = stack.pop(); blocks[b][1] = i
                depth -= 1
                last_closed[depth] = b
                last_closed.pop(depth + 1, None)
            hdr_start = i + 1
        elif c == ';':
            hdr_start = i + 1
    for b in blocks:
        if b[1] is None: b[1] = len(text)
    return blocks

def chain_conds(blocks, bi):
    """For block bi, return list of (cond, polarity) that must hold to enter it."""
    hdr = blocks[bi][2]
    m = HDR_IF.match(hdr)
    out = []
    if m:
        out.append((m.group(2), True))
        if m.group(1):          # else if: all earlier siblings in chain false
            out += _earlier(blocks, bi)
    elif HDR_ELSE.match(hdr):
        out += _earlier(blocks, bi)
    return out

def _earlier(blocks, bi):
    res, p = [], blocks[bi][3]
    guard = 0
    while p is not None and guard < 50:
        h = blocks[p][2]
        m = HDR_IF.match(h)
        if not m:
            break
        res.append((m.group(2), False))
        if not m.group(1):
            break
        p = blocks[p][3]; guard += 1
    return res
