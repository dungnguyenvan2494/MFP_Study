# Rule.makes

include $(BASEPATH)/rule_sw.makes

ifeq ($(CROSS_COMPILE),ppc440-linux-)
	CPU				= PPC440
else
	CPU				= PPC603
endif

DF_TYPE					= EDH
INCLUDE_PIC				= YES
INCLUDE_MIO				= YES
NETFAX					= YES
IOPTIONCOM				= YES
IEEE1284_INTERFACE 		= NO
USB20_INTERFACE			= YES
ROM_DIV					= YES
ROM_DIV_2				= YES
ROM_DIV_3				= YES
AES_FTP_OFF				= NO
AUTH_LIB				= YES
OSWRAPPER_LIB			= NO
MNG_LIB					= YES
FOREMP_LIB				= NO
EMPRIPPERFORM			= NO
SOFTWARE_PERFORM		= NO
EMPPROCESS_DIVIDE	 	= NO
DIVLIB_DEBUG_LOG		= NO

CC_OPTIM_TARGET 		=     -fno-builtin -fno-inline -fsigned-char 

#XWINDOW definition
ifeq ($(XWINDOW_ENABLE), YES)
 TSS_DEFINES   += -DXWINDOW_ENABLE
endif

#NODE-BLACK TEST TOOLS
ifeq ($(DEF_NODEBLACK_TEST),YES)
 TSS_DEFINES   += -DDEF_NODEBLACK_TEST
endif


ifeq ($(BASETYPE),hw)
ifeq ($(CROSS_COMPILE),mpc8536-linux-)
CC_ARCH_SPEC			= -mstrict-align -mlongcall -DINET6
else
ifeq ($(CROSS_COMPILE),ppc440-linux-)
CC_ARCH_SPEC			= -mstrict-align -mlongcall -DINET6
else
ifeq ($(CROSS_COMPILE),mv78460-linux-)
CC_ARCH_SPEC			= -mcpu=marvell-pj4b -mfpu=vfpv3 -mabi=aapcs-linux -mlittle-endian -fwrapv -DINET6
else
ifeq ($(CROSS_COMPILE),mb86s73-linux-)
CC_ARCH_SPEC			= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -funwind-tables -DINET6
else
ifeq ($(CROSS_COMPILE),mb86s72-linux-)
CC_ARCH_SPEC			= -mcpu=cortex-a15 -mfpu=neon-vfpv4 -mfloat-abi=hard -mlong-calls -mlittle-endian -mthumb -funwind-tables -fno-aggressive-loop-optimizations -DINET6
else
ifeq ($(CROSS_COMPILE),mv62x0-linux-)
CC_ARCH_SPEC			= -march=armv7-a -marm -mthumb-interwork -mfloat-abi=hard -mfpu=neon -mthumb -mlittle-endian -mtls-dialect=gnu -DINET6
else
ifeq ($(CROSS_COMPILE),s800-linux-)
CC_ARCH_SPEC			=  -mlittle-endian -DINET6
else
CC_ARCH_SPEC			= -mcpu=604 -mstrict-align -mlongcall -DINET6
endif
endif
endif
endif
endif
endif
endif
else
CC_ARCH_SPEC			= 
endif

ifeq ($(ADDRESS_SANITIZER),YES)
CC_ARCH_SPEC			+= -fno-omit-frame-pointer -fsanitize-recover=all -fsanitize=address
endif

UTMODE					= NO
CTMODE					= NO
DMYCOMMONAPI			= NO
DEBUGMODE				= NO
AR						= $(CROSS_COMPILE)ar
AS						= $(CROSS_COMPILE)as
CC						= $(CROSS_COMPILE)gcc
CF						=
CP						= cp
LD						= $(CROSS_COMPILE)ld
LDOUT_CONV				= @rem
LDOUT_SYMS				= @rem
NM						= $(CROSS_COMPILE)nm
SIZE					= $(CROSS_COMPILE)size
RANLIB					= $(CROSS_COMPILE)ranlib
RM						= rm
LN						= ln

ARCH_DIR				= ppc
ifeq ($(BASETYPE),all)
ifeq ($(SIM_DIVLIB_ENABLE_GGDB), YES)
DBGFLAGS = -g -ggdb -O2
else
DBGFLAGS = -O2
endif
else
DBGFLAGS = -g -ggdb -O2
endif

CPP						= $(CC) -E -P -xc

LDFLAGS					= -X -N -Map DonauBoot.map
ifeq ($(CROSS_COMPILE),s800-linux-)
	LDFLAGS			+= 
endif

###############################################################################
# depend名設定
ifeq ($(IT4MACHINE_TYPE),Minerva)
DEPEND_INC		= _minerva.depend
endif
ifeq ($(IT4MACHINE_TYPE),MinervaBK)
TSS_DEFINES	   += -DDEF_MinervaBKCus -DDEF_MonoCus
DEPEND_INC		= _minervabk.depend
endif

ifeq ($(IT4MACHINE_TYPE),Zeus)
TSS_DEFINES	   += -DDEF_ZeusCus
DEPEND_INC		= _zeus.depend
endif

ifeq ($(IT4MACHINE_TYPE),SoCZeus)
	ifeq ($(THRMACHINE_TYPE),ZeusS)
		TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_Asic777_PMS
		DEPEND_INC		= _ZeusS.depend
	else
		TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard
		DEPEND_INC		= _SoCZeus.depend
	endif
endif
ifeq ($(IT4MACHINE_TYPE),arxp)
TSS_DEFINES	   += -DDEF_ZeusCus -DDEF_ZeusMLKCus -DDEF_Soc1200 -DDEF_ZeusMLKBoard -DDEF_ARMADAXP -DDEF_SYS_EVA_1ST -DDEF_NOT_PERMIT_ASIC30_PRINT
